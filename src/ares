def _load_settings() -> Dict[str, Any]:
    """Load the settings from $AGENT_RESUME_HOME/data/settings.json, with defaults."""
    defaults: Dict[str, Any] = {
        "local_projects_dir": "~/.claude/projects",
        "local_index_dir": os.path.join(ARES_DATA_DIR, "indexes"),
        "ignore_path_substrings": [],
        "sync_stale_warning_hours": 24,
        "remote_ssh_host": "",
        "codex_sessions_dir": "~/.codex/sessions",
        "codex_session_index_file": "~/.codex/session_index.jsonl",
        # None = auto-detect (enabled iff codex_sessions_dir exists); an explicit
        # true/false in settings.json overrides the auto-detect.
        "codex_enabled": None,
    }
    try:
        with open(SETTINGS_PATH) as f:
            user = json.load(f)
        for k, v in user.items():
            if isinstance(v, bool):
                defaults[k] = v
            elif isinstance(v, str) and v != "":
                defaults[k] = v
            elif isinstance(v, list) and k == "ignore_path_substrings":
                defaults[k] = [s for s in v if isinstance(s, str) and s]
            elif isinstance(v, (int, float)) and not isinstance(v, bool):
                defaults[k] = v
    except (OSError, json.JSONDecodeError):
        pass
    return defaults

