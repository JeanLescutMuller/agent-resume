TOP_DESCRIPTION = f"""ares {VERSION} - agent-resume (was asm): find and resume agent sessions

  resume  → refreshes the changed index entries here and on the remote_hosts, then searches them all
            ($AGENT_RESUME_HOME/data/indexes/, data/remote/<host>/); another machine's session resumes there (ssh)
  tmux    → after a crash, restores the previous boot's tmux sessions and Claude sessions
  reindex → builds the JSON index from local .jsonl files
  sync    → copies the transcripts both ways with the sync_hosts (created or extended, never shortened or deleted)

`asm` is an alias of `ares`. Closing a running session: claude-close-keep-screen."""


# Each command: its help line, then its flags in --help order, (names..., default, help). The default tells the kind
# of flag: False an on/off switch, "" a text, a number or None (no default) a whole number.
COMMANDS = {
