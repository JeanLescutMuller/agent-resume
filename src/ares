def main():
    """Main entry point."""
    parser = argparse.ArgumentParser(
        prog="ares",
        description=TOP_DESCRIPTION,
        epilog="Run `ares <command> --help` for that command's full flag list and examples.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="version", version=f"ares {VERSION}")
    subparsers = parser.add_subparsers(dest="command")

    for command, (help_text, l_flags) in COMMANDS.items():
        # the --help epilog: the command's slice of EXAMPLES
        rows = [(ex, note) for cmd, ex, note in EXAMPLES if cmd == command]
        width = max(len(ex) for ex, _ in rows)
        lines = ["Examples:"]
        for ex, note in rows:
            lines.append(f"  {ex.ljust(width)}   # {note}" if note else f"  {ex}")
        p = subparsers.add_parser(command, help=help_text, epilog="\n".join(lines),
                                  formatter_class=argparse.RawDescriptionHelpFormatter)
        for *names, default, flag_help in l_flags:
            if default is False:
                p.add_argument(*names, action="store_true", help=flag_help)
            elif default == "":
                p.add_argument(*names, default=default, help=flag_help)
            else:
                p.add_argument(*names, type=int, default=default, help=flag_help)
        if command == "resume":   # --help lists it apart, under "positional arguments"
            p.add_argument("keywords", nargs="*", help="Keywords to search for")

    args = parser.parse_args()

    if not args.command:
        parser.print_help(sys.stderr)
        sys.exit(1)

    if args.command == "resume":
        # SearchOpts's fields, in their order
        opts = SearchOpts(args.keywords, args.from_days_ago, args.until_days_ago, args.host, args.state, args.agent,
                          args.tmux, args.max_scan, args.uuid, args.verbose)
        cmd_resume(opts, args.fork, args.print_cmd)
    elif args.command == "tmux":
        sys.exit(cmd_tmux(args.dry_run, args.all, not args.no_iterm, args.this_boot))
    elif args.command == "sync":
        sys.exit(cmd_sync([args.host] if args.host else [], args.dry_run,
                          _SETTINGS["sync_since_days"] if args.since_days is None else args.since_days,
                          _SETTINGS["sync_max_size_mb"] if args.max_size_mb is None else args.max_size_mb,
                          {u for u in args.uuid.split(",") if u}, args.agent))
    elif args.command == "sync-serve":
        sys.exit(cmd_sync_serve())
    elif args.command == "reindex":
        cmd_reindex(args.max, args.force, args.uuid)


if __name__ == "__main__":
    main()
