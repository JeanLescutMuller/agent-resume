# -- Commands ---------------------------------------------------------------

def plan_reindex(force: bool = False, single_uuid: str = "",
                 max_sessions: int = 0) -> Tuple[List[Tuple[str, str, "Backend"]], Dict[str, int]]:
    """Which transcripts to (re)index: [(jsonl_path, idx_path, backend)], plus counts.

    Only dates are read here (one stat per transcript, index file and lifecycle):
    ~4 ms for 3,014 transcripts (agent-tracker DESIGN §3, verified 2026-11-07).
    """
    d_history: Dict[str, Tuple[float, Backend]] = {}
    for backend in BACKENDS.values():
        for p, m in backend.scan().items():
            d_history[p] = (m, backend)
    if single_uuid:
        d_history = {p: v for p, v in d_history.items() if v[1].uuid_of(p) == single_uuid}
    d_index = scan_index_dir(LOCAL_INDEX_DIR)
    idx_mtime_by_uuid = {Path(p).stem: mtime for p, mtime in d_index.items()}

    l_todo: List[Tuple[str, str, Backend]] = []
    d_counts = {"history": len(d_history), "index": len(d_index), "skipped": 0, "ignored": 0, "duplicates": 0}
    s_seen: set = set()
    for jsonl_path, (jsonl_mtime, backend) in d_history.items():
        if max_sessions and len(s_seen) >= max_sessions:
            break
        uuid = backend.uuid_of(jsonl_path)
        if uuid in s_seen:
            d_counts["duplicates"] += 1
            continue
        s_seen.add(uuid)
        if is_ignored_session(jsonl_path):
            d_counts["ignored"] += 1
        elif not force and not needs_reindex(uuid, jsonl_mtime, idx_mtime_by_uuid.get(uuid)):
            d_counts["skipped"] += 1
        else:
            l_todo.append((jsonl_path, os.path.join(LOCAL_INDEX_DIR, f"{uuid}.json"), backend))
    d_counts["scanned"] = len(s_seen)
    return l_todo, d_counts


def run_reindex(l_todo: List[Tuple[str, str, "Backend"]],
                report: Optional[Callable[[str, Optional[Exception], str, str], None]] = None) -> Tuple[int, int]:
    """Index the given transcripts, 10 at a time. Returns (indexed, errors).

    report(uuid, exc, title, source) is called once per transcript, from the main thread.
    """
    indexed = errors = 0

    def worker(jsonl_path: str, idx_path: str, backend: Backend) -> Tuple[str, Optional[Exception], str, str]:
        uuid = backend.uuid_of(jsonl_path)
        try:
            title, source = index_one(backend, jsonl_path, idx_path)
            return (uuid, None, title, source)
        except Exception as e:
            return (uuid, e, "", "")

    if not l_todo:
        return 0, 0
    Path(LOCAL_INDEX_DIR).mkdir(parents=True, exist_ok=True)
    with ThreadPoolExecutor(max_workers=min(10, len(l_todo))) as executor:
        for future in as_completed([executor.submit(worker, *t) for t in l_todo]):
            uuid, exc, title, source = future.result()
            indexed, errors = indexed + (exc is None), errors + (exc is not None)
            if report:
                report(uuid, exc, title, source)
    return indexed, errors


def refresh_index(verbose: bool = False) -> None:
    """Before a search: re-index only the transcripts newer than their index entry (agent-tracker DESIGN §3).

    Silent, and never fatal: a failure just means the search reads the index as it was.
    """
    try:
        l_todo, d_counts = plan_reindex()
        indexed, errors = run_reindex(l_todo)
        log_verbose(f"refresh: {d_counts['scanned']} transcripts dated, {indexed} re-indexed, {errors} errors", verbose)
    except Exception as e:   # the index stays as it was; the search still runs
        log_verbose(f"refresh skipped: {e}", verbose)


def cmd_reindex(max_sessions: int = 0, force: bool = False, single_uuid: str = "") -> Dict[str, int]:
    """Build/refresh index JSON files from local JSONL files, with a progress log.

    Step 1: scan local .jsonl history files; Step 2: scan the .json index files;
    Step 3: decide what to reindex (3a), then reindex in parallel (3b).
    """
    mode = "force-reindex" if force else "reindex"
    if single_uuid:
        mode = f"reindex --uuid {single_uuid[:8]}"
    print(f"ares {VERSION} - {mode}" + (f" (max {max_sessions})" if max_sessions else ""), flush=True)
    Path(LOCAL_INDEX_DIR).mkdir(parents=True, exist_ok=True)

    l_todo, d_counts = plan_reindex(force, single_uuid, max_sessions)
    print(f"  Step 1: {d_counts['history']} .jsonl history files found", flush=True)
    print(f"  Step 2: {d_counts['index']} .json index files in local cache", flush=True)
    print(f"  Step 3a: {d_counts['scanned']} sessions scanned, {len(l_todo)} to reindex, "
          f"{d_counts['skipped']} up to date, {d_counts['ignored']} ignored, "
          f"{d_counts['duplicates']} duplicates", flush=True)

    done = 0

    def report(uuid: str, exc: Optional[Exception], title: str, source: str) -> None:
        """One [i/N] progress line per transcript."""
        nonlocal done
        done += 1
        if exc is None:
            marker = TITLE_SOURCE_MARKERS.get(source, "⚠️")
            print(f"    [{done}/{len(l_todo)}] {uuid[:8]}  indexed {marker} {title[:60]}", flush=True)
        else:
            print(f"    [{done}/{len(l_todo)}] {uuid[:8]}  ERROR: {exc}", file=sys.stderr, flush=True)

    indexed, errors = run_reindex(l_todo, report)
    print(f"  Step 3b: indexed={indexed}, errors={errors}")
    return {"sessions_scanned": d_counts["scanned"], "sessions_indexed": indexed,
            "sessions_skipped": d_counts["skipped"], "errors": errors}


# -- Sync awareness ---------------------------------------------------------

def _read_sync_log_tail(max_lines: int = 200) -> List[Dict[str, Any]]:
    """Read up to the last max_lines entries from $AGENT_RESUME_HOME/data/sync-log.jsonl.

    Slices the raw lines before parsing: the log gains an entry per sync
    attempt forever, and only the tail is ever of interest.
    """
    try:
        with open(SYNC_LOG_PATH, encoding="utf-8", errors="replace") as f:
            lines = f.readlines()[-max_lines:]
    except OSError:
        return []
    entries = []
    for line in lines:
        try:
            entries.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return entries


def _maybe_pull_before_resume(verbose: bool = False) -> None:
    """Opportunistic, rate-limited pull of the remote index before searching.

    Never blocks more than a few seconds and never raises - a failed or timed
    out pull just means ares resume searches whatever's already local."""
    entries = _read_sync_log_tail()
    if entries:
        last_attempt = parse_ts(entries[-1].get("timestamp"))
        if last_attempt and (datetime.now(timezone.utc) - last_attempt).total_seconds() < 60:
            log_verbose("Skipping opportunistic pull (attempted <60s ago)", verbose)
            return
    try:
        subprocess.run(
            [os.path.join(os.path.dirname(os.path.realpath(__file__)), "ares-sync"), "--pull"],
            timeout=5, capture_output=True,
            stdin=subprocess.DEVNULL,
        )
    except Exception as e:
        log_verbose(f"Opportunistic pull skipped: {e}", verbose)


def _sync_staleness_warning() -> Optional[str]:
    """Return a warning string if the last successful sync is stale/missing, else None."""
    last_success = next(
        (parse_ts(e.get("timestamp")) for e in reversed(_read_sync_log_tail())
         if e.get("outcome") == "success"), None)
    if last_success is None:
        return "never synced with remote yet"
    age_hours = (datetime.now(timezone.utc) - last_success).total_seconds() / 3600
    if age_hours <= SYNC_STALE_WARNING_HOURS:
        return None
    if age_hours >= 48:
        return f"last synced with remote {age_hours / 24:.0f}d ago"
    return f"last synced with remote {age_hours:.0f}h ago"


# -- Picking a session -------------------------------------------------------

def pick_session(opts: SearchOpts, action_verb: str) -> Tuple[str, Dict[str, Any]]:
    """Refresh the index, search it and let the user pick one session in fzf.

    Exits the process on an empty result or a cancelled picker; never returns None.
    """
    if _SETTINGS.get("remote_ssh_host", ""):
        _maybe_pull_before_resume(opts.verbose)
        warning = _sync_staleness_warning()
        if warning:
            print(f"\033[38;5;208m⚠ {warning}\033[0m", file=sys.stderr)

    refresh_index(opts.verbose)   # after the pull: a local transcript wins over a pulled copy of its entry
    if not os.path.isdir(LOCAL_INDEX_DIR):
        print(f"ERROR: local index cache not found at {LOCAL_INDEX_DIR}", file=sys.stderr)
        print("  Run 'ares reindex' first to build the local cache.", file=sys.stderr)
        sys.exit(1)

    sessions, fuzzy = find_sessions(opts)
    if fuzzy:
        print("  (no exact matches - showing fuzzy results)", file=sys.stderr)

    uuid, doc = run_fzf(sessions, opts.keywords, opts.verbose, action_verb)
    if not uuid or not doc:
        sys.exit(0)
    return uuid, doc


# -- Resume -----------------------------------------------------------------

def cmd_resume(opts: SearchOpts, fork: bool = False, print_cmd: bool = False) -> None:
    """Find and resume a session.

    print_cmd builds the exact command and prints it to stdout (nothing else)
    instead of exec'ing it - a scriptable, non-interactive seam for tests that
    need to assert on resume/fork command construction without ever launching
    either agent's TUI.
    """
    if opts.uuid:
        refresh_index(opts.verbose)
        doc = find_by_uuid(opts.uuid)
        if not doc:
            print(f"ERROR: no indexed session matches uuid '{opts.uuid}'.", file=sys.stderr)
            sys.exit(1)
        uuid = doc.get("session_id", opts.uuid)
    else:
        uuid, doc = pick_session(opts, action_verb="Resume")

    if doc.get("_source_missing", False):
        if print_cmd:
            print(f"ERROR: session {uuid} not found locally, cannot build a resume command.",
                  file=sys.stderr)
            sys.exit(1)
        # The .jsonl itself is gone - either deleted locally, or this doc came
        # from a machine that has never synced .jsonl files (ares-sync only ever
        # moves the index, never the transcript), so a real resume is not
        # possible either way. /inject-session reads the indexed conversation straight
        # into a new session instead.
        print("\n\033[38;5;208mSession not found locally.\033[0m")
        print(f"  UUID:  {uuid}")
        print(f"  Title: {doc.get('custom_title', '')}")
        print(f"  Slug:  {doc.get('slug', '')}")
        print(f"\n  True resume is not possible: the .jsonl transcript isn't on this machine.")
        print(f"  Open Claude and run: /inject-session {uuid}")
        sys.exit(0)

    backend = BACKENDS.get(doc.get("agent_type") or "claude", BACKENDS["claude"])
    slug = doc.get("slug", "")
    initial_wd = doc.get("initial_working_dir", "")
    latest_wd = doc.get("latest_working_dir", "")

    # Re-read the transcript: it holds the permission mode, and a title that
    # may be newer than the indexed one if the session was renamed since.
    jsonl_path = _resolve_jsonl_path(doc.get("jsonl_path", ""))
    transcript = backend.parse(jsonl_path, warn=False) if jsonl_path else None
    perm_mode = transcript.permission_mode if transcript else None
    title = (transcript.title if transcript else None) or doc.get("custom_title", "")

    working_dir = backend.resolve_working_dir(doc, opts.verbose)

    if not print_cmd:
        # -- Session info (same format used by /info skill) --
        print("")
        print(f"Title:              {title or '(not set)'}")
        print(f"UUID:               {uuid}")
        print(f"Original WD:        {initial_wd}")
        print(f"Latest WD:          {latest_wd or initial_wd}")
        print(f"JSONL file:         {jsonl_path or '(unknown)'}")
        print(f"Permission mode:    {perm_mode or '(unknown)'}")
        print(f"Selected local dir: {working_dir or '(none)'}")

    if not (working_dir and os.path.isdir(working_dir)):
        if print_cmd:
            print(f"ERROR: no accessible working directory for session {uuid}.", file=sys.stderr)
            sys.exit(1)
        print("Command:            (cannot resume, directory not found)")
        print("")
        print(f"\033[33mWARNING: no accessible directory found for slug: {slug}\033[0m")
        print(f"  Original dir: {initial_wd}")
        print("")
        print("True resume is not possible from here.")
        print(f"Open Claude and run: /inject-session {uuid}")
        print("")
        return

    cmd = backend.resume_cmd(doc, transcript, working_dir, uuid, fork)

    if print_cmd:
        print(cmd)
        return

    print(f"Command:            {cmd}")
    print("")
    print(f"{'Forking' if fork else 'Resuming'} in {working_dir} ...")
    os.execv("/bin/bash", ["/bin/bash", "-c", cmd])


# -- Crash restore: ares tmux (agent-tracker IMPLEMENTATION.md §5) -----------
#
# After a crash, put back what ran at the end of the previous boot, read from
# agent-tracker's files only (no snapshot of our own):
#
#   prev boot   = the newest boot_ts in data/sessions/*/ that is not this boot
#   candidates  = Claude sessions whose open start line (open_start) is of that boot
#   one per pane_id: the newest last_seen.ts wins (the pane was reused)
#   stale       = no last_seen.json of that boot, or last_seen.ts more than 2 min older than the
#                 boot's newest last_seen.ts (it had stopped ticking: killed before the crash);
#                 restored only with --all
#   per tmux session (never one that already exists): its windows (index, name, size),
#   as many panes as the saved window_layout has, select-layout, then in each Claude pane
#   `cd <dir> && claude --resume <uuid>`; plain panes are shells in ~ (their folder is not recorded);
#   then one iTerm2 tab per restored tmux session (AppleScript), unless --no-iterm.
#
# Only windows that held a Claude session are known (only Claude sessions write last_seen.json).

STALE_AFTER_S = 120    # agent-tracker IMPLEMENTATION.md §5: "more than 2 min older"
SAME_BOOT_S = 60       # macOS shifts kern.boottime by a few seconds when the clock is stepped
LAYOUT_CELL_RE = re.compile(r"(\d+)x(\d+),\d+,\d+(?:,(\d+))?")   # WxH,X,Y[,pane number]


def current_boot_ts() -> int:
    """This boot's start (epoch s): $AGENT_TRACKER_BOOT_TS (tests), sysctl kern.boottime, or /proc/stat btime."""
    if os.environ.get("AGENT_TRACKER_BOOT_TS"):
        return int(os.environ["AGENT_TRACKER_BOOT_TS"])
    if sys.platform == "darwin":
        out = subprocess.run(["sysctl", "-n", "kern.boottime"], capture_output=True, text=True).stdout
        m = re.search(r"sec = (\d+)", out)
        return int(m.group(1)) if m else 0
    for line in Path("/proc/stat").read_text().splitlines():
        if line.startswith("btime "):
            return int(line.split()[1])
    return 0


def layout_cells(layout: Optional[str]) -> Tuple[Optional[Tuple[int, int]], List[int]]:
    """'b25f,208x52,0,0{104x52,0,0,1,103x52,105,0,2}' -> ((208, 52), [1, 2]): window size, pane numbers in pane order."""
    if not layout or "," not in layout:
        return None, []
    l_cells = LAYOUT_CELL_RE.findall(layout.split(",", 1)[1])
    if not l_cells:
        return None, []
    size = (int(l_cells[0][0]), int(l_cells[0][1]))
    return size, [int(n) for _, _, n in l_cells if n]


def _fmt_ts(ts: Any) -> str:
    try:
        return datetime.fromtimestamp(int(ts), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except (TypeError, ValueError, OverflowError, OSError):
        return "?"


def tmux_plan(include_stale: bool, this_boot: bool = False) -> Dict[str, Any]:
    """Read agent-tracker's files and decide what to restore (no tmux call).

    this_boot: the tmux server died without a reboot: candidates are this boot's Claude sessions
    whose process is gone without a clean exit (killed_start), instead of the previous boot's.

    Returns {"boot_ts", "newest_ts", "sessions": {name: {window_index: window}}, "stale": [row],
    "outside": [row]} or {"boot_ts": None} when there is no previous boot. A row is one Claude
    session: {"uuid", "seen", "start", "ts", "cmd"}; a window: {"name", "layout", "size",
    "panes": [row or None]} (None = a plain shell).
    """
    boot_now = current_boot_ts()
    same_boot = lambda a, b: a is not None and b is not None and abs(int(a) - int(b)) <= SAME_BOOT_S

    l_rows = []
    for folder in sorted(glob.glob(os.path.join(TRACKER_SESSIONS_DIR, "*", ""))):
        uuid = os.path.basename(folder.rstrip("/"))
        seen = read_json(os.path.join(folder, "last_seen.json")) or {}
        l_events = read_lifecycle(uuid)
        l_rows.append({"uuid": uuid, "seen": seen, "start": open_start(l_events), "events": l_events,
                       "boots": [seen.get("boot_ts")] + [e.get("boot_ts") for e in l_events]})

    if this_boot:
        prev = boot_now
    else:
        l_boots = sorted({int(b) for r in l_rows for b in r["boots"] if isinstance(b, (int, float))
                          and not same_boot(b, boot_now)}, reverse=True)
        if not l_boots:
            return {"boot_ts": None}
        prev = l_boots[0]

    l_cand = []
    for r in l_rows:
        start = killed_start(r["events"], lambda b: same_boot(b, prev)) if this_boot else r["start"]
        if not start or not same_boot(start.get("boot_ts"), prev) or (start.get("agent") or "claude") != "claude":
            continue
        if this_boot and pid_alive(start.get("pid")):
            continue   # still running: nothing to restore
        r["start"] = start
        r["seen"] = r["seen"] if same_boot(r["seen"].get("boot_ts"), prev) else {}
        l_cand.append(r)

    # The moment of the crash, roughly: the newest tick among the candidates (this boot also holds live ones).
    newest_ts = max((int(r["seen"]["ts"]) for r in l_cand if r["seen"].get("ts")), default=0)

    d_by_pane: Dict[str, Dict[str, Any]] = {}
    l_outside: List[Dict[str, Any]] = []
    for r in l_cand:
        start, seen = r["start"], r["seen"]
        r["ts"] = int(seen.get("ts") or start.get("ts") or 0)
        r["stale"] = not seen.get("ts") or r["ts"] < newest_ts - STALE_AFTER_S
        r["cmd"] = _tmux_resume_cmd(r["uuid"], seen, start)
        pane_id = seen.get("pane_id") or start.get("pane_id")
        if not pane_id:
            l_outside.append(r)
        elif pane_id not in d_by_pane or r["ts"] > d_by_pane[pane_id]["ts"]:
            d_by_pane[pane_id] = r

    d_sessions: Dict[str, Dict[int, Dict[str, Any]]] = {}
    l_stale = []
    for pane_id, r in sorted(d_by_pane.items(), key=lambda kv: -kv[1]["ts"]):   # newest first
        if r["stale"] and not include_stale:
            l_stale.append(r)
            continue
        seen = r["seen"]
        session, window, _ = split_pane(seen.get("pane") or r["start"].get("pane"))
        session = seen.get("tmux_session") or session
        try:
            widx = int(seen["window_index"] if seen.get("window_index") is not None else window)
        except (TypeError, ValueError):
            widx = 0
        if not session:
            l_outside.append(r)
            continue
        w = d_sessions.setdefault(session, {}).setdefault(widx, {"name": None, "layout": None, "claude": {}})
        if w["name"] is None:   # rows come newest first: the newest one gives the window's name and layout
            w["name"], w["layout"] = seen.get("window_name"), seen.get("window_layout")
        w["claude"][pane_id] = r

    for d_windows in d_sessions.values():
        for w in d_windows.values():
            # One pane per cell of the saved layout, in pane order; a cell with no Claude session is a plain shell.
            w["size"], l_numbers = layout_cells(w["layout"])
            d_claude = dict(w.pop("claude"))
            w["panes"] = [d_claude.pop(f"%{n}", None) for n in l_numbers]
            if d_claude:   # a Claude pane the saved layout does not hold (layout older than the pane): add it
                w["panes"] += sorted(d_claude.values(), key=lambda r: int(r["seen"].get("pane_index") or 0))
                w["layout"] = "tiled"
            if not w["panes"]:
                w["panes"], w["layout"] = [None], None

    return {"boot_ts": prev, "newest_ts": newest_ts, "sessions": d_sessions, "stale": l_stale,
            "outside": l_outside}


def _tmux_resume_cmd(uuid: str, seen: Dict[str, Any], start: Dict[str, Any]) -> str:
    """`cd <dir> && claude --resume <uuid>`, in the folder `claude --resume` needs.

    That folder is the one of the transcript's project slug (the folder the session started in);
    it is decoded like `ares resume` does, else agent-tracker's start cwd, else the last cwd, else ~.
    """
    transcript = seen.get("transcript") or ""
    slug = Path(os.path.expanduser(transcript)).parent.name if transcript else ""
    wd = (resolve_working_dir(slug) if slug else None) or start.get("cwd") or seen.get("cwd")
    if not (wd and os.path.isdir(wd)):
        wd = HOME
    return f"cd {shlex.quote(wd)} && claude --resume {shlex.quote(uuid)}"


def _applescript_str(s: str) -> str:
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def iterm_script(l_sessions: List[str]) -> str:
    """AppleScript: one new iTerm2 window, one tab per tmux session, each attaching to it."""
    l_osa = ['tell application "iTerm2"', "  set w to (create window with default profile)"]
    for i, name in enumerate(l_sessions):
        if i:
            l_osa.append("  tell w to create tab with default profile")
        # Always quoted: in zsh an unquoted word starting with '=' is "the path of that command" (=name -> "zsh: name
        # not found"), and shlex.quote leaves '=name' bare (2026-11-07, the first real ares tmux).
        target = "=" + name
        cmd = "tmux attach -t '" + target.replace("'", "'\\''") + "'"
        l_osa.append(f"  tell current session of w to write text {_applescript_str(cmd)}")
    return "\n".join(l_osa + ["end tell"])


def cmd_tmux(dry_run: bool = False, include_stale: bool = False, iterm: bool = True, this_boot: bool = False) -> int:
    """Print the plan; unless dry_run, carry it out. Returns the exit status."""
    plan = tmux_plan(include_stale, this_boot)
    if not this_boot:   # a tmux server killed without a reboot leaves this boot's sessions to restore too
        n_now = sum(1 for d in tmux_plan(True, True)["sessions"].values() for w in d.values() for p in w["panes"] if p)
        if n_now:
            print(f"ares tmux: {n_now} Claude session(s) of THIS boot ended without a clean exit (tmux server killed?):"
                  f" ares tmux --this-boot --dry-run")
    if plan["boot_ts"] is None:
        print(f"ares tmux: no previous boot in {TRACKER_SESSIONS_DIR}: nothing to restore."
              f" If the tmux server died without a reboot: ares tmux --this-boot --dry-run")
        return 0

    def tmux(*l_args: str) -> str:
        """Run one tmux command; its output, stripped. Raises on failure."""
        out = subprocess.run(["tmux", *l_args], capture_output=True, text=True)
        if out.returncode != 0:
            raise RuntimeError(f"tmux {' '.join(shlex.quote(a) for a in l_args)}: {out.stderr.strip()}")
        return out.stdout.strip()

    def exists(name: str) -> bool:
        return subprocess.run(["tmux", "has-session", "-t", f"={name}"],
                              capture_output=True).returncode == 0

    n_claude = sum(1 for ws in plan["sessions"].values() for w in ws.values() for p in w["panes"] if p)
    which = "this boot (tmux died without a reboot)" if this_boot else "previous boot"
    print(f"ares tmux{' --this-boot' if this_boot else ''}{' --dry-run' if dry_run else ''}: {which} {_fmt_ts(plan['boot_ts'])}, "
          f"its last tick {_fmt_ts(plan['newest_ts'])}; {n_claude} Claude session(s) in tmux then"
          f"{'' if include_stale else ' (stale ones need --all)'}")

    l_restored: List[str] = []
    errors = 0
    for name, d_windows in plan["sessions"].items():
        l_claude = [p for w in d_windows.values() for p in w["panes"] if p]
        if exists(name):
            print(f"  skip     tmux session {name!r}: already exists, left as is. Its Claude session(s), by hand:")
            for r in l_claude:
                print(f"             {r['cmd']}")
            continue
        print(f"  restore  tmux session {name!r}: {len(d_windows)} window(s)")
        for widx, w in sorted(d_windows.items()):
            size = f"{w['size'][0]}x{w['size'][1]}" if w["size"] else "default size"
            print(f"    window {widx} {w['name']!r}, {size}, {len(w['panes'])} pane(s), layout {w['layout']}")
            for i, r in enumerate(w["panes"]):
                print(f"      pane {i}  {r['cmd'] + ('   (stale)' if r['stale'] else '') if r else 'shell in ~'}")
        if dry_run:
            l_restored.append(name)
            continue
        try:
            sid = None
            for widx, w in sorted(d_windows.items()):
                l_size = ["-x", str(w["size"][0]), "-y", str(w["size"][1])] if w["size"] else []
                l_name = ["-n", w["name"]] if w["name"] else []
                if sid is None:
                    sid = tmux("new-session", "-d", "-P", "-F", "#{session_id}", "-s", name, *l_name,
                               *l_size, "-c", HOME)
                    wid, got = tmux("display-message", "-p", "-t", f"{sid}:", "#{window_id} #{window_index}").split()
                    if int(got) != widx:   # the first window lands on base-index: move it to its saved index
                        tmux("move-window", "-s", wid, "-t", f"{sid}:{widx}")
                else:
                    wid = tmux("new-window", "-d", "-P", "-F", "#{window_id}", "-t", f"{sid}:{widx}", *l_name,
                               "-c", HOME)
                if l_size:   # the saved size first, or the splits below may not fit
                    tmux("resize-window", "-t", wid, *l_size)
                for _ in w["panes"][1:]:
                    tmux("split-window", "-d", "-t", wid, "-c", HOME)
                if w["layout"]:
                    tmux("select-layout", "-t", wid, w["layout"])
                if l_size:   # resize-window fixed the size: let it follow the terminal again once attached
                    tmux("set-option", "-w", "-u", "-t", wid, "window-size")
                l_pane_ids = tmux("list-panes", "-t", wid, "-F", "#{pane_id}").split()
                for pane_id, r in zip(l_pane_ids, w["panes"]):
                    if r:
                        tmux("send-keys", "-t", pane_id, r["cmd"], "Enter")
            l_restored.append(name)
        except (RuntimeError, OSError) as e:
            errors += 1
            print(f"  ERROR    tmux session {name!r}: {e}", file=sys.stderr)

    for r in plan["stale"]:
        where = r["seen"].get("pane") or r["start"].get("pane") or "?"
        seen = f"last seen {_fmt_ts(r['ts'])}" if r["seen"].get("ts") else "no last_seen.json of that boot"
        print(f"  stale    {r['uuid']} in {where}: {seen} (not restored; --all restores it)")
    for r in plan["outside"]:
        print(f"  no tmux  {r['uuid']}: by hand: {r['cmd']}")

    if not l_restored:
        print("  iTerm2   nothing to open")
    elif not iterm:
        print(f"  iTerm2   skipped (--no-iterm); attach with: tmux attach -t ={l_restored[0]}")
    else:
        script = iterm_script(l_restored)
        if dry_run:
            print("  iTerm2   one tab per restored tmux session:\n" + "\n".join("    " + l for l in script.splitlines()))
        elif sys.platform != "darwin":
            print("  iTerm2   skipped (not macOS)")
        else:
            out = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
            if out.returncode == 0:
                print(f"  iTerm2   {len(l_restored)} tab(s) opened")
            else:
                errors += 1
                print(f"  ERROR    iTerm2: {out.stderr.strip()}", file=sys.stderr)
    return 1 if errors else 0


