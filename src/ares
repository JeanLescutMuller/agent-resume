# Examples are written once here and filtered per-subcommand into that
# subparser's --help epilog, instead of a hand-maintained HELP blob that
# duplicates flag descriptions already given to argparse via add_argument().
EXAMPLES: List[Tuple[str, str, Optional[str]]] = [
    ("resume", "ares resume", None),
    ("resume", "ares resume profiling hallucination", None),
    ("resume", "ares resume -f 30 cai benchmarking", None),
    ("resume", "ares resume --host myserver", None),
    ("resume", "ares resume --state pending", None),
    ("resume", "ares resume --agent codex", "only sessions from a given agent"),
    ("resume", "ares resume --tmux mywork", 'only sessions started in tmux session "mywork"'),
    ("resume", "ares resume --fork", "fork instead of resume"),
    ("resume", "ares resume --uuid <uuid> --print-cmd", "print the resume command, don't run it"),
    ("resume", "ares resume --max-scan 200", None),
    ("resume", "ares resume -v", "with verbose logging"),
    ("resume", "ares resume --uuid 31967223-656d-41a3-8ed3-56dbcc37ef38", "skip search, resume directly"),
    ("tmux", "ares tmux --dry-run", "after a crash: print what would be restored"),
    ("tmux", "ares tmux", "restore it, then one iTerm2 tab per tmux session"),
    ("tmux", "ares tmux --all --no-iterm", "also the stale Claude sessions; no iTerm2 tab"),
    ("reindex", "ares reindex", None),
    ("reindex", "ares reindex -n 5", "reindex at most 5 sessions"),
    ("reindex", "ares reindex --force", "force reindex, ignoring mtime-based skip"),
]


def _epilog_for(command: str) -> str:
    """Render this command's slice of EXAMPLES as a --help epilog."""
    rows = [(ex, note) for cmd, ex, note in EXAMPLES if cmd == command]
    width = max(len(ex) for ex, _ in rows)
    lines = ["Examples:"]
    for ex, note in rows:
        lines.append(f"  {ex.ljust(width)}   # {note}" if note else f"  {ex}")
    return "\n".join(lines)


TOP_DESCRIPTION = f"""ares {VERSION} - agent-resume (was asm): find and resume agent sessions

  resume  → refreshes the changed index entries, then searches ($AGENT_RESUME_HOME/data/indexes/)
  tmux    → after a crash, restores the previous boot's tmux sessions and Claude sessions
  reindex → builds the JSON index from local .jsonl files

`asm` is an alias of `ares`. Closing a running session moved to agent-auto-close."""

TOP_EPILOG = "Run `ares <command> --help` for that command's full flag list and examples."

CLOSE_POINTER = "ares close moved to agent-auto-close: run `agent-auto-close close <uuid|%pane>`."


def _add_search_args(p: argparse.ArgumentParser) -> None:
    """Search/filter flags of 'resume'."""
    p.add_argument("-f", "--from-days-ago", type=int, default=90, help="Only sessions active in last N days (default: 90)")
    p.add_argument("-u", "--until-days-ago", type=int, help="Only sessions active more than N days ago")
    p.add_argument("--host", default="", help="Filter by hostname")
    p.add_argument("--state", default="", help="Filter by session state (pending, exited, deleted)")
    p.add_argument("--agent", default="", help=f"Filter by agent type ({', '.join(sorted(BACKENDS))})")
    p.add_argument("--tmux", default="", help="Filter by tmux session name")
    p.add_argument("--max-scan", type=int, default=50, help="Max recent files to scan without keywords (default: 50)")
    p.add_argument("--uuid", default="", help="Skip the search, directly act on this session UUID")
    p.add_argument("-v", "--verbose", action="store_true", help="Enable verbose logging")
    p.add_argument("keywords", nargs="*", help="Keywords to search for")


def main() -> None:
    """Main entry point."""
    if sys.argv[1:2] == ["close"]:   # before argparse: any flags after it are close's, not ours
        print(CLOSE_POINTER, file=sys.stderr)
        sys.exit(1)

    parser = argparse.ArgumentParser(
        prog="ares",
        description=TOP_DESCRIPTION,
        epilog=TOP_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="version", version=f"ares {VERSION}")
    subparsers = parser.add_subparsers(dest="command")

    resume_parser = subparsers.add_parser(
        "resume", help="Find and resume a past session",
        epilog=_epilog_for("resume"), formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    _add_search_args(resume_parser)
    resume_parser.add_argument("--fork", action="store_true", help="Fork the session instead of resuming it")
    resume_parser.add_argument("--print-cmd", action="store_true",
                               help="Print the resume/fork command instead of running it (scripting/testing)")

    tmux_parser = subparsers.add_parser(
        "tmux", help="After a crash: restore the previous boot's tmux sessions and Claude sessions",
        epilog=_epilog_for("tmux"), formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    tmux_parser.add_argument("--dry-run", action="store_true", help="Print the plan, change nothing")
    tmux_parser.add_argument("--this-boot", action="store_true",
                             help="The tmux server died without a reboot: restore this boot's Claude sessions whose "
                                  "process is gone without a clean exit")
    tmux_parser.add_argument("--all", action="store_true",
                             help="Also restore stale Claude sessions (stopped ticking > 2 min before the crash)")
    tmux_parser.add_argument("--no-iterm", action="store_true", help="Do not open iTerm2 tabs")

    reindex_parser = subparsers.add_parser(
        "reindex", help="Re-index all sessions now",
        epilog=_epilog_for("reindex"), formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    reindex_parser.add_argument("-n", "--max", type=int, default=0, help="Max sessions to process (0 = unlimited, default: 0)")
    reindex_parser.add_argument("--force", action="store_true", help="Force reindex all sessions, ignoring mtime-based skip")
    reindex_parser.add_argument("--uuid", default="", help="Reindex a single session by UUID")

    args = parser.parse_args()

    if not args.command:
        parser.print_help(sys.stderr)
        sys.exit(1)

    if args.command == "resume":
        cmd_resume(SearchOpts.from_args(args), args.fork, args.print_cmd)
    elif args.command == "tmux":
        sys.exit(cmd_tmux(args.dry_run, args.all, not args.no_iterm, args.this_boot))
    elif args.command == "reindex":
        cmd_reindex(args.max, args.force, args.uuid)


if __name__ == "__main__":
    main()
