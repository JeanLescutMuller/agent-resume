# -- Utilities --------------------------------------------------------------

def eprint(*args, **kwargs):
    """print() to stderr: every error, warning and log line of ares."""
    print(*args, file=sys.stderr, **kwargs)


def run_text(l_cmd):
    """Run a command and wait: its stdout and stderr captured as text; a failing exit is in .returncode, not raised."""
    return subprocess.run(l_cmd, capture_output=True, text=True)


def log_verbose(msg, verbose):
    """Print message to stderr with timestamp if verbose."""
    if verbose:
        ts = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S")
        eprint(f"[{ts}] {msg}")


def parse_ts(ts_str):
    """Parse an ISO 8601 '...Z' timestamp, or None if absent/unparseable.

    Every timestamp in the index is written in this one
    format, and half a dozen call sites used to each re-implement the
    .replace("Z", "+00:00") dance inside their own try/except.
    """
    if not ts_str:
        return None
    try:
        return datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
    except (ValueError, TypeError, AttributeError):
        return None


def _make_portable_jsonl_path(abs_path):
    """Convert absolute jsonl_path to portable ~/.claude/projects/... format.

    $HOME differs across machines (e.g. /Users/alice on a laptop vs
    /home/bob on a VM), and another machine's index is copied here (pull_remotes)
    to be searched and shown.
    """
    marker = "/.claude/projects/"
    idx = abs_path.find(marker)
    if idx != -1:
        return "~/.claude/projects/" + abs_path[idx + len(marker):]
    if abs_path.startswith(HOME + "/"):
        return "~/" + abs_path[len(HOME) + 1:]
    return abs_path


def _resolve_jsonl_path(stored_path):
    """Resolve a stored jsonl_path (possibly with ~) to an absolute path.

    A stored path is "~/..." or absolute (_make_portable_jsonl_path): expanduser leaves an absolute one as is."""
    return os.path.expanduser(stored_path)


def read_json(path):
    """Load one JSON file, or None if it is missing or malformed."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return None


# -- JSON Index Writer -----------------------------------------------------

def write_json_atomic(doc, json_path):
    """Write JSON to temp file then rename (atomic on POSIX)."""
    Path(json_path).parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(Path(json_path).parent), suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(doc, f, ensure_ascii=False, indent=2)
            f.write("\n")
        os.replace(tmp, json_path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# -- JSONL Parser -----------------------------------------------------------

# Transcript text arrives wrapped in bookkeeping tags - hook output, slash
# command plumbing, system reminders - that are noise both for keyword search
# and for the picker snippet. One alternation with a backreference strips them
# all in a single pass; adding a tag is a one-word edit to this tuple.
NOISE_TAGS = (
    "system-reminder", "local-command-caveat", "message", "task-notification",
    "command-name", "command-message", "command-args", "local-command-stdout",
    "role", "source_space", "instructions",
)
NOISE_RE = re.compile(r"<(" + "|".join(NOISE_TAGS) + r")\b[^>]*>.*?</\1>", re.DOTALL)


def iter_entries(jsonl_path, warn=False):
    """Yield one dict per line of a .jsonl file, skipping blank/malformed ones.

    Every transcript reader in ares used to
    carry its own copy of this loop (open, strip, json.loads, swallow the
    decode error). A truncated final line is normal: Claude Code appends to
    these files live, so a session being written right now can be mid-line.
    """
    try:
        with open(jsonl_path, encoding="utf-8", errors="replace") as f:
            for raw in f:
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    yield json.loads(raw)
                except json.JSONDecodeError:
                    continue
    except OSError as e:
        if warn:
            eprint(f"  WARNING: could not read {jsonl_path}: {e}")


def extract_text(content, block_types=("text",)):
    """Flatten a message's content (str, or list of blocks of these types) to clean text."""
    if isinstance(content, str):
        text = content
    elif isinstance(content, list):
        parts = [b.get("text", "") for b in content
                 if isinstance(b, dict) and b.get("type") in block_types]
        text = "\n".join(p for p in parts if p)
    else:
        return ""
    return NOISE_RE.sub("", text).strip()


def is_tool_result(entry):
    """True for a user entry that is really a tool result, not a human turn."""
    content = entry.get("message", {}).get("content", "")
    if isinstance(content, list):
        return any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content)
    return False


class Transcript(NamedTuple):
    """Everything ares reads out of one .jsonl session transcript.

    Built by a single pass in read_transcript(). Indexing needs the messages,
    resume needs only the title and permission mode, but both used to walk
    the whole file with their own near-identical loop - and the title-priority
    rule had already drifted between the two copies.
    """
    cwd: Optional[str]
    messages: List[Dict[str, Any]]           # the real conversation turns: {role, timestamp, text}
    ai_title: Optional[str]                  # Claude Code's own auto-generated title
    custom_title: Optional[str] = None       # set explicitly via /rename
    permission_mode: Optional[str] = None
    # False for a session no human typed in: `claude -p` / Agent SDK runs,
    # Codex sub-agents and `codex exec`. Kept in the index, hidden in the picker.
    interactive: bool = True

    @property
    def title(self):
        """Best available title: an explicit /rename beats Claude's ai-title."""
        return self.custom_title or self.ai_title

    @property
    def created_at(self):
        """The first turn's timestamp (the first turn that has one)."""
        return next((m["timestamp"] for m in self.messages if m["timestamp"] is not None), None)

    @property
    def last_active(self):
        """The last turn's timestamp."""
        return self.messages[-1]["timestamp"] if self.messages else None


def read_transcript(jsonl_path, warn=True):
    """Parse a session .jsonl into a Transcript (single pass over the file)."""
    custom_title = ai_title = permission_mode = cwd = entrypoint = None
    messages = []

    for entry in iter_entries(jsonl_path, warn=warn):
        etype = entry.get("type", "")
        # "cli" = an interactive session; "sdk-cli" = `claude -p`, "sdk-py" /
        # "sdk-ts" = the Agent SDK. Older transcripts have no entrypoint at all.
        entrypoint = entrypoint or entry.get("entrypoint")

        if etype == "custom-title":
            custom_title = entry.get("customTitle") or custom_title
            continue

        if etype == "ai-title":
            ai_title = entry.get("aiTitle") or ai_title
            continue

        cwd = cwd or entry.get("cwd")
        if etype == "user":
            permission_mode = entry.get("permissionMode") or permission_mode

        # Only real conversation turns count as activity: a tool result is
        # bookkeeping, and an entry whose text is entirely noise tags is too.
        if etype == "assistant" or (etype == "user" and not is_tool_result(entry)):
            text = extract_text(entry.get("message", {}).get("content", ""))
            if text:   # its role is etype: "user" or "assistant"
                messages.append({"role": etype, "timestamp": entry.get("timestamp"), "text": text})

    return Transcript(
        custom_title=custom_title,
        ai_title=ai_title,
        permission_mode=permission_mode,
        cwd=cwd,
        messages=messages,
        interactive=not (entrypoint or "").startswith("sdk-"),
    )


# -- Codex backend: transcript parsing ---------------------------------------
# Codex's rollout .jsonl is shaped completely differently from Claude's: each
# line is {timestamp, type, payload}. The working directory comes straight off
# the first "session_meta" line's payload.cwd (no slug-decoding needed, unlike
# Claude). Titles aren't in the transcript at all - they live in a separate
# append-only log, ~/.codex/session_index.jsonl ({id, thread_name,
# updated_at}), latest line per id wins - so they're looked up separately and
# mapped onto Transcript.ai_title (Codex has no /rename-equivalent "custom"
# title source, so custom_title is always None for this backend).

@lru_cache(maxsize=None)
def _codex_session_titles():
    """uuid -> latest thread_name from ~/.codex/session_index.jsonl.

    Cached for the lifetime of the process: the file only grows during a
    reindex run, and re-reading it once per session would be O(sessions^2).
    """
    titles = {}
    for entry in iter_entries(CODEX_SESSION_INDEX_FILE):
        sid, name = entry.get("id"), entry.get("thread_name")
        if sid and name:
            titles[sid] = name
    return titles


def read_codex_transcript(jsonl_path, warn=True):
    """Parse a Codex rollout .jsonl into a Transcript (single pass over the file)."""
    session_id = cwd = None
    interactive = True
    messages = []

    for entry in iter_entries(jsonl_path, warn=warn):
        etype = entry.get("type")
        payload = entry.get("payload") or {}

        if etype == "session_meta":
            session_id = payload.get("session_id") or payload.get("id") or session_id
            cwd = payload.get("cwd") or cwd
            # source is "cli" / "vscode" for a human, "exec" for `codex exec`,
            # and a dict ({"subagent": ...}) for a sub-agent such as guardian.
            source = payload.get("source")
            interactive = interactive and not (isinstance(source, dict) or source == "exec")
            continue

        if etype != "response_item" or payload.get("type") != "message":
            continue

        # "developer"-role entries are injected instructions (AGENTS.md, skill
        # text, mode reminders) - bookkeeping, not a conversation turn, exactly
        # like a Claude tool_result is excluded by is_tool_result() above.
        role = payload.get("role")
        if role not in ("user", "assistant"):
            continue

        content = payload.get("content")
        text = ""   # a plain-string content is not a Codex message: it counts as no text
        if isinstance(content, list):
            text = extract_text(content, ("input_text", "output_text"))
        if text:
            messages.append({"role": role, "timestamp": entry.get("timestamp"), "text": text})

    return Transcript(
        ai_title=_codex_session_titles().get(session_id or ""),
        cwd=cwd,
        messages=messages,
        interactive=interactive,
    )


# -- Session Index Building -------------------------------------------------

def resolve_title(t):
    """Pick the session's display title and record where it came from."""
    if t.custom_title:
        return t.custom_title, "custom"
    if t.ai_title:
        return t.ai_title, "ai"
    if not any(m["role"] == "user" and m["text"].strip() for m in t.messages):
        return "[Empty session]", "empty"
    return "Untitled session [prompt]", "untitled"


# -- agent-tracker's files (read only) ---------------------------------------
# $AGENT_TRACKER_HOME/data/sessions/<uuid>/lifecycle.jsonl: one line per start / end, appended by
# `agent-tracker hook start|end`; last_seen.json: where the session runs, rewritten by
# `agent-tracker tick` (the formats: agent-tracker's IMPLEMENTATION.md §4). They replace asm's own
# lifecycle hook and its data/lifecycles/ sidecars (2026-11-07).

def lifecycle_path(uuid):
    return os.path.join(TRACKER_SESSIONS_DIR, uuid, "lifecycle.jsonl")


def read_lifecycle(uuid):
    """The lifecycle lines of one session, oldest first ([] if agent-tracker has none).

    A line without its final newline is still being appended: it is ignored
    (agent-tracker's contract), as is any line that is not a JSON object.
    """
    try:
        with open(lifecycle_path(uuid), encoding="utf-8", errors="replace") as f:
            data = f.read()
    except OSError:
        return []
    l_events = []
    for raw in data.split("\n")[:-1]:   # the piece after the last newline is incomplete (or empty)
        try:
            d_ev = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if isinstance(d_ev, dict):
            l_events.append(d_ev)
    return l_events


def open_start(lifecycle_events):
    """The newest start line not followed by an end of the same pid, or None.

    The pid makes it right when a resume starts while the old process is still
    ending (two hooks of one session, end line written after the new start):
    that end closes the old start, not the new one. An end line without a pid
    closes every start before it.
    """
    d_open = {}   # pid -> its start line, in file order
    for ev in lifecycle_events:
        pid = ev.get("pid")
        if ev.get("event") == "start":
            d_open.pop(pid, None)   # re-inserted last: the newest start
            d_open[pid] = ev
        elif ev.get("event") == "end" and pid is None:
            d_open.clear()
        elif ev.get("event") == "end":
            d_open.pop(pid, None)
    return list(d_open.values())[-1] if d_open else None


def killed_start(lifecycle_events, boot_ts):
    """The Claude session's NEWEST start line, when it is of that boot (same_boot) and its process ended
    without a clean exit: no end line of its pid after it (a power cut), or one with reason "other" (what
    Claude Code logs when the tmux server or the terminal dies under it: 2026-11-07 15:30). None otherwise:
    resumed again later (by hand, or in a newer boot), or ended cleanly (prompt_input_exit, clear, logout).
    A terminal tab closed on purpose also logs "other": the stale rule (tmux_plan) keeps it out unless --all."""
    l_idx = [i for i, ev in enumerate(lifecycle_events) if ev.get("event") == "start"]
    if not l_idx:
        return None
    i = l_idx[-1]
    st = lifecycle_events[i]
    if not same_boot(st.get("boot_ts"), boot_ts):
        return None
    for ev in lifecycle_events[i + 1:]:
        if ev.get("event") == "end" and (ev.get("pid") is None or ev.get("pid") == st.get("pid")):
            return st if (ev.get("reason") or "other") == "other" else None
    return st


def pid_alive(pid):
    """Whether a process with this pid runs now (signal 0)."""
    try:
        os.kill(int(pid), 0)
    except (TypeError, ValueError, ProcessLookupError):
        return False
    except PermissionError:
        return True
    return True


def determine_state(lifecycle_events):
    """'pending' if the session has a start with no end yet (running, or killed by a crash), 'exited' otherwise."""
    return "pending" if open_start(lifecycle_events) else "exited"


def split_pane(pane):
    """'work:2.1' -> ('work', '2', '1'); None or a malformed value -> (None, None, None)."""
    if not pane or ":" not in pane:
        return None, None, None
    session, rest = pane.rsplit(":", 1)
    window, _, pane_index = rest.partition(".")
    return session or None, window or None, pane_index or None


def index_one(uuid, jsonl_path, backend):
    """Build the index document of one session and write it: indexes/<uuid>.json, or indexes/hidden/<uuid>.json
    for a session nobody typed in. Returns (title, source): source is "custom" (via /rename), "ai" (native
    ai-title), "empty" (no messages), or "untitled" (has messages but no title)."""
    transcript = backend.parse(jsonl_path)
    lifecycle_events = read_lifecycle(uuid)
    title, title_source = resolve_title(transcript)

    # The transcript's own cwd is authoritative; agent-tracker's start lines
    # only fill the gap for sessions that never recorded one.
    l_starts = [ev for ev in lifecycle_events if ev.get("event") == "start"]
    initial_working_dir = transcript.cwd or next((ev["cwd"] for ev in l_starts if ev.get("cwd")), None)

    # First start: where the session was born (host, tmux place); latest start: where it last ran.
    first = l_starts[0] if l_starts else {}
    initial_hostname = first.get("machine") or None
    tmux_session, tmux_window, tmux_pane = split_pane(first.get("pane"))
    latest_hostname = next((ev["machine"] for ev in reversed(l_starts) if ev.get("machine")), None)
    latest_working_dir = next((ev["cwd"] for ev in reversed(l_starts) if ev.get("cwd")), None)

    doc = {
        "asm_version": VERSION,
        "agent_type": backend.name,
        "session_id": uuid,
        "custom_title": title,
        "title_source": title_source,
        "jsonl_path": _make_portable_jsonl_path(jsonl_path),
        "slug": Path(jsonl_path).parent.name,
        "initial_working_dir": initial_working_dir,
        "latest_working_dir": latest_working_dir,
        "initial_hostname": initial_hostname,
        "latest_hostname": latest_hostname,
        # The machine that indexed this copy of the transcript (since 2026-11-22 a transcript may be on several:
        # ares sync). Fills the gap for sessions with no lifecycle line (older ones, or a copy never resumed
        # here), where the two fields above are null.
        "index_hostname": LOCAL_HOSTNAME or None,
        "created_at": transcript.created_at,
        "last_active": transcript.last_active,
        "session_state": determine_state(lifecycle_events),
        "interactive": transcript.interactive,
        "permission_mode": transcript.permission_mode,
        "tmux_session": tmux_session,
        "tmux_window": tmux_window,
        "tmux_pane": tmux_pane,
        "conversation": transcript.messages,   # [{role, timestamp, text}]
    }

    idx_path = os.path.join(LOCAL_INDEX_DIR, f"{uuid}.json")
    other_path = os.path.join(HIDDEN_INDEX_DIR, f"{uuid}.json")
    if not transcript.interactive:
        idx_path, other_path = other_path, idx_path
    write_json_atomic(doc, idx_path)   # it makes the folder
    if os.path.exists(other_path):
        os.remove(other_path)   # its entry from before the hidden/ split, or of the other kind
    return title, title_source


# -- Search options ---------------------------------------------------------

class SearchOpts(NamedTuple):
    """The filter/search flags of 'resume'.

    These travel together through find_sessions and pick_session, so they move
    as one value rather than as ten positional arguments.
    """
    keywords: List[str]
    from_days: int = 90
    until_days: Optional[int] = None
    host: str = ""
    state: str = ""
    agent: str = ""
    tmux: str = ""
    max_scan: int = 50
    uuid: str = ""
    verbose: bool = False


# -- Session Search ---------------------------------------------------------

# [(folder of index entries, its ssh host or None for this machine)]: this machine's, then each remote copy.
INDEX_DIRS = [(LOCAL_INDEX_DIR, None)] + [(os.path.join(REMOTE_INDEX_DIR, h), h)
                                          for h in REMOTE_HOSTS]


def load_index_doc(path, host):
    """Read one index file and tag it: _host, the machine it lives on (None: this one), and _source_missing,
    whether its .jsonl is gone (checked on this machine only)."""
    doc = read_json(path)
    if doc is None:
        return None
    doc["_host"] = host
    jsonl_path = doc.get("jsonl_path")
    doc["_source_missing"] = not host and (not jsonl_path
                                           or not os.path.exists(_resolve_jsonl_path(jsonl_path)))
    return doc


def fold(s):
    """Lower-case and without accents ('Zürich' -> 'zurich'), for matching keywords."""
    return "".join(c for c in unicodedata.normalize("NFKD", s.casefold()) if not unicodedata.combining(c))


def searchable_text(doc):
    """Text keywords are matched against: title, dirs, and the conversation.

    Deliberately excludes metadata (asm_version, hostnames, session_id), which
    would otherwise make every session match a keyword like the hostname.
    """
    parts = [str(doc[k]) for k in ("custom_title", "initial_working_dir", "latest_working_dir")
             if doc.get(k)]
    parts += [m["text"] for m in doc.get("conversation", []) if m.get("text")]
    return "\n".join(parts)


# An index entry's host fields, the best first: where it last ran, where it was born (agent-tracker's start lines),
# which machine indexed it.
HOST_FIELDS = ("latest_hostname", "initial_hostname", "index_hostname")


def passes_filters(doc, opts, cutoff_from, cutoff_until):
    """Apply the --state / --host / --agent / --tmux / --from / --until filters to one session."""
    # Sessions nobody typed in (`claude -p`, Agent SDK, Codex sub-agents) are
    # never shown; `--uuid` still finds them. Docs indexed before v4.7 have no
    # field and stay visible until the next reindex.
    if doc.get("interactive") is False:
        return False

    # 'deleted' is not a session_state in the index - it means the source
    # .jsonl is gone - so a session whose .jsonl is gone has that state, and no other.
    state = "deleted" if doc.get("_source_missing") else (doc.get("session_state") or "").lower()
    if opts.state and state != opts.state.lower():
        return False

    if opts.host and not any(opts.host.lower() in str(doc.get(k) or "").lower() for k in HOST_FIELDS):
        return False

    if opts.agent and (doc.get("agent_type") or "claude").lower() != opts.agent.lower():
        return False

    if opts.tmux and opts.tmux.lower() not in (doc.get("tmux_session") or "").lower():
        return False

    ts = parse_ts(doc.get("last_active"))
    if not ts:   # no date: it cannot be inside a date range (only `-f 0` without --until shows these)
        return not (cutoff_from or cutoff_until)
    if cutoff_from and ts < cutoff_from:
        return False
    return not (cutoff_until and ts > cutoff_until)


def find_sessions(opts):
    """Find matching sessions in the index.

    Returns ([(doc, idx_path), ...], fuzzy_flag). Exact substring matching is
    tried first; only if that finds nothing do we retry on 3-character
    prefixes, and flag the result as fuzzy so the caller can say so.
    """
    verbose = opts.verbose
    log_verbose("PHASE 1: Python search started", verbose)
    log_verbose(f"index_dir = {LOCAL_INDEX_DIR}", verbose)

    now = datetime.now(timezone.utc)
    cutoff_from = now - timedelta(days=opts.from_days) if opts.from_days > 0 else None
    cutoff_until = now - timedelta(days=int(opts.until_days)) if opts.until_days else None

    idx_files = [(p, host) for d, host in INDEX_DIRS for p in glob.glob(os.path.join(d, "*.json"))]
    log_verbose(f"PHASE 2: Found {len(idx_files)} index files", verbose)

    # (doc, idx_path, searchable text) for everything surviving the filters
    candidates = []
    for idx_path, host in idx_files:
        doc = load_index_doc(idx_path, host)
        if doc is None:
            log_verbose(f"PHASE 2: ERROR reading {os.path.basename(idx_path)}", verbose)
            continue
        if passes_filters(doc, opts, cutoff_from, cutoff_until):
            text = searchable_text(doc)
            candidates.append((doc, idx_path, fold(text) if opts.keywords else text))

    # One row per session: a session copied here by ares sync is also in the copy of the other machine's index;
    # the newer copy wins, this machine's on a tie (R6.7: resume the local copy unless the other one is longer).
    d_best = {}
    for cand in candidates:
        sid = cand[0].get("session_id")
        prev = d_best.get(sid)
        if prev is None or (cand[0].get("last_active") or "") > (prev[0].get("last_active") or ""):
            d_best[sid] = cand
    candidates = list(d_best.values())

    # Sort by last_active (most recent first)
    candidates.sort(key=lambda item: item[0].get("last_active", "") or "", reverse=True)
    log_verbose(f"PHASE 3: {len(candidates)} sessions after filtering", verbose)

    # Apply max_scan limit (only when no keywords)
    if not opts.keywords:
        candidates = candidates[:opts.max_scan]

    l_kw = [fold(kw) for kw in opts.keywords]   # none: every candidate matches
    matched = [c for c in candidates if all(kw in c[2] for kw in l_kw)]
    fuzzy = not matched and bool(opts.keywords)
    if fuzzy:
        log_verbose("PHASE 4: Trying fuzzy match...", verbose)
        matched = [c for c in candidates if all(kw[:3] in c[2] for kw in l_kw)]

    # Rank matched sessions. Title match is the strongest signal.
    # Within title-matching sessions, prefer most recent (stable sort preserves recency).
    # Within non-title-matching sessions, prefer higher TF density.
    if opts.keywords:
        def rank_key(item):
            doc, _, text = item
            title = fold(doc.get("custom_title") or "")
            if all(kw in title for kw in l_kw):
                return (0, 0.0)  # title match: stable sort keeps recency order
            n_tokens = len(text.split()) or 1
            hits = sum(text.count(kw) for kw in l_kw)
            return (1, -hits / n_tokens)

        matched.sort(key=rank_key)

    log_verbose(f"PHASE 5: {len(matched)} sessions matched (fuzzy={fuzzy})", verbose)
    return [(doc, path) for doc, path, _ in matched], fuzzy


def find_by_uuid(uuid):
    """Load one index doc by exact UUID, or by UUID prefix if no exact file
    exists. Used by --uuid to skip search/fzf entirely. None if 0 matches;
    exits with an error message (not just None) if the prefix is ambiguous,
    since silently picking one would be the wrong failure mode here."""
    l_dirs = [(LOCAL_INDEX_DIR, None), (HIDDEN_INDEX_DIR, None)] + INDEX_DIRS[1:]
    l_exact = [doc for d, host in l_dirs for doc in [load_index_doc(os.path.join(d, f"{uuid}.json"), host)] if doc]
    if l_exact:   # the newest copy, this machine's on a tie (as find_sessions)
        return max(l_exact, key=lambda doc: doc.get("last_active") or "")   # max keeps the first of equals

    candidates = [(p, host) for d, host in l_dirs for p in glob.glob(os.path.join(d, "*.json"))
                  if Path(p).stem.startswith(uuid)]
    if len(candidates) > 1:
        eprint(f"ERROR: multiple indexed sessions match uuid prefix '{uuid}':")
        for p, _ in candidates:
            eprint(f"  {Path(p).stem}")
        sys.exit(1)
    return load_index_doc(*candidates[0]) if candidates else None


# -- Session Display & Selection --------------------------------------------

def clean_field(doc, key):
    """One index field as a real string, or None if it is missing or a placeholder."""
    v = doc.get(key)
    s = "" if v is None else str(v).strip()
    return None if s in ("", "null", "?") else s


def time_ago(ts_str):
    """Compact fixed-width age: ' 5 min ago', ' 3 hou ago', or a date if older."""
    ts = parse_ts(ts_str)
    if ts is None:
        return " " * 10
    secs = max(0, int((datetime.now(timezone.utc) - ts).total_seconds()))
    if secs < 60:
        return f"{secs:2d} sec ago"
    mins = secs // 60
    if mins < 60:
        return f"{mins:2d} min ago"
    hours = mins // 60
    if hours < 24:
        return f"{hours:2d} hou ago"
    return ts.strftime("%Y-%m-%d")


def extract_snippet(conversation, keywords, max_chars=120):
    """One line of context for the picker's preview pane.

    With keywords, show the first message containing one, windowed around the
    hit so the match is visible. Without, show the opening user prompt.
    """
    for msg in conversation:
        text = msg.get("text", "").replace("\n", " ").strip()
        if not text:
            continue
        if not keywords:
            if msg.get("role") == "user":
                return text[:max_chars] + ("..." if len(text) > max_chars else "")
            continue
        hit = next((kw for kw in keywords if kw.lower() in text.lower()), None)
        if hit:
            idx = text.lower().find(hit.lower())
            start = max(0, idx - 40)
            snippet = text[start:start + max_chars].strip()
            if start > 0:
                snippet = "..." + snippet
            if start + max_chars < len(text):
                snippet += "..."
            return f"[{msg.get('role', '?')} {(msg.get('timestamp') or '')[:10]}] {snippet}"
    return ""


def status_block(doc):
    """The '[ Pending  5 min ago ]' prefix, colored by state and freshness."""
    last_active = doc.get("last_active") or ""
    if doc.get("_source_missing"):
        label, color = "Deleted", C_DELETED
    elif not clean_field(doc, "initial_hostname"):
        # A session with no lifecycle line has no start/end events at all, so
        # its state was never observed - say "Unknown" rather than assert "Exited".
        label, color = "Unknown", C_INACTIVE
    elif clean_field(doc, "session_state") == "exited":
        label, color = "Exited", C_INACTIVE
    else:
        label = "Pending"
        ts = parse_ts(last_active)
        if ts is None:
            color = C_HALFDAY  # no usable timestamp: not fresh, but not ancient either
        else:
            mins = (datetime.now(timezone.utc) - ts).total_seconds() / 60
            color = next((c for limit, c in FRESHNESS_RAMP if mins < limit), C_STALE)

    return f"{color}[ {label:<7} {time_ago(last_active)} ]{RESET}"


def agent_block(doc):
    """Agent-type tag ('[claude]'/'[codex]'), always shown and color-coded so
    the two backends are visually distinguishable at a glance in a mixed
    picker."""
    agent = doc.get("agent_type") or "claude"
    color = C_AGENT_CLAUDE if agent == "claude" else C_AGENT_CODEX
    return f"{color}[{agent}]{RESET}"


def host_block(doc):
    """The hostname segment: 'mac' in blue if local, another host in dark red."""
    for k in HOST_FIELDS:   # the first one set
        host = short_host(clean_field(doc, k))
        if host:
            break

    # Sessions predating the lifecycle hook have no lifecycle and, until they get
    # reindexed, no index_hostname either - but if their .jsonl is on this disk
    # they resume here (a copy made by ares sync included).
    if not host and not doc.get("_source_missing"):
        host = doc.get("_host") or LOCAL_HOSTNAME
    if not host:
        return ""
    color = C_HOST_LOCAL if host == LOCAL_HOSTNAME else C_HOST_REMOTE
    return f"{color}{host}{RESET}"


def format_session_for_fzf(doc, idx_path, keywords):
    """One fzf row: visible columns, then tab-separated fields for the preview.

    Layout is 'display \t snippet \t title-source \t uuid'; fzf shows only
    field 1 (--with-nth=1) and the preview command reads fields 2 and 3.
    """
    uuid = doc.get("session_id", os.path.basename(idx_path).replace(".json", ""))
    title = clean_field(doc, "custom_title") or uuid
    working_dir = clean_field(doc, "latest_working_dir") or clean_field(doc, "initial_working_dir")

    source = doc.get("title_source")
    marker = TITLE_SOURCE_MARKERS.get(source, "")
    title_str = f"\033[97m{marker + ' ' if marker else ''}{title}{RESET}"
    source_label = f"Title: {TITLE_SOURCE_LABELS[source]}" if source in TITLE_SOURCE_LABELS else ""

    columns = [status_block(doc), title_str, agent_block(doc), host_block(doc),
               f"{C_DIR}{working_dir}{RESET}" if working_dir else "", f"{C_UUID}{uuid[:8]}...{RESET}"]
    display = "  ".join(c for c in columns if c)   # an empty column takes no room

    snippet = extract_snippet(doc.get("conversation", []), keywords)
    return f"{display}\t{snippet}\t{source_label}\t{uuid}"


def pick_session(opts):
    """Search the index and let the user pick one session in fzf: (uuid, doc).

    Exits the process on an empty result or a cancelled picker; never returns None.
    """
    if not os.path.isdir(LOCAL_INDEX_DIR):
        eprint(f"ERROR: local index cache not found at {LOCAL_INDEX_DIR}")
        eprint("  Run 'ares reindex' first to build the local cache.")
        sys.exit(1)

    sessions, fuzzy = find_sessions(opts)
    if fuzzy:
        eprint("  (no exact matches - showing fuzzy results)")
    if not sessions:
        eprint("No sessions found.")
        sys.exit(0)

    keywords = opts.keywords
    docs_by_uuid = {doc["session_id"]: doc for doc, _ in sessions if doc.get("session_id")}
    fzf_input = "".join(format_session_for_fzf(doc, path, keywords) + "\n"
                        for doc, path in sessions)

    # Preview shows the title-source label (field 3) above the snippet (field 2),
    # with the search terms highlighted in the snippet when there are any.
    preview_cmd = 'printf "%s\\n%s\\n" {3} {2}'
    if keywords:
        kw_pat = "|".join(keywords)
        preview_cmd = (f"printf '%s\\n' {{3}}; printf '%s\\n' {{2}} | "
                       f"GREP_COLOR='1;31' GREP_COLORS='ms=1;31' grep -iE --color=always '{kw_pat}|$'")

    try:
        result = subprocess.run(
            [
                "fzf",
                "--ansi",
                "--delimiter=\t",
                "--with-nth=1",
                "--preview", preview_cmd,
                "--preview-window=down:3:wrap",
                f"--prompt=[{VERSION}] Resume session: ",
                "--height=80%",
                "--layout=reverse",
                "--no-multi",
            ],
            input=fzf_input,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        eprint("ERROR: fzf not found. Install it with: brew install fzf")
        sys.exit(0)

    if result.returncode != 0:
        eprint("Cancelled.")
        sys.exit(0)

    selected = result.stdout.strip()
    if not selected:
        eprint("No session selected.")
        sys.exit(0)

    uuid = selected.split("\t")[-1]
    log_verbose(f"UUID selected: {uuid}", opts.verbose)
    doc = docs_by_uuid.get(uuid)
    if not doc:
        sys.exit(0)
    return uuid, doc


# -- Resume folder -------------------------------------------------------------
# `claude --resume <uuid>` finds the transcript from any folder (Claude Code's docs, "Resume by session ID or name";
# no changelog line, between v2.1.140 and v2.1.323; tested 2026-11-20 on v2.1.329), and `codex resume` always did.
# So a session no longer has to resume in the folder of its transcript's project slug (decoded from the slug until
# 2026-11-20): it resumes in the last folder it ran in (the user, 2026-11-20).

def resume_dir(doc):
    """The folder a session resumes in: the last one it ran in (agent-tracker's newest start, else the transcript's
    first cwd) when it still exists, else the current folder. A session of another machine: that folder as is, else
    ~ (it is tested there: resume_shell_cmd)."""
    wd = doc.get("latest_working_dir") or doc.get("initial_working_dir")
    if doc.get("_host"):
        return wd or "~"
    return wd if wd and os.path.isdir(wd) else os.getcwd()


def resume_shell_cmd(doc, agent_cmd):
    """The shell command that resumes a session: `cd <resume_dir> && <agent command>` for one of this machine; for
    one of another machine, the same there over `ssh -t` (its own folder test: a gone folder falls back to ~).
    `claude` is my-setup's account selector on every machine (~/.local/bin/claude, 2026-11-20)."""
    host = doc.get("_host")
    wd = shlex.quote(resume_dir(doc))
    if not host:
        return f"cd {wd} && {agent_cmd}"
    remote = f'PATH="$HOME/.local/bin:$PATH"; cd {wd} 2>/dev/null || cd; {agent_cmd}'
    return f"ssh -t {shlex.quote(host)} {shlex.quote(remote)}"


# -- Claude backend adapters --------------------------------------------------

def _claude_resume_cmd(doc, transcript, uuid, fork):
    """The `claude --resume` command (the folder is resume_shell_cmd's). The transcript, when readable here, gives
    the newest permission mode and title; else the index's."""
    perm_mode = transcript.permission_mode if transcript else doc.get("permission_mode")
    title = (transcript.title if transcript else None) or doc.get("custom_title", "")
    claude_flags = "--dangerously-skip-permissions " if perm_mode == "bypassPermissions" else ""
    cmd = f"claude {claude_flags}--resume {shlex.quote(uuid)}"
    if fork:
        cmd += " --fork-session"
    if title:
        clean_title = re.sub(r'\s*\[prompt\]\s*$', '', title)
        cmd += f" {shlex.quote('/rename ' + clean_title)}"
    return cmd


# -- Codex backend adapters ---------------------------------------------------

# Codex names transcripts rollout-<timestamp>-<uuid>.jsonl - the uuid is
# always the last 36 characters before the extension.
_CODEX_UUID_RE = re.compile(
    r'-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$')


def _codex_uuid_of(jsonl_path):
    m = _CODEX_UUID_RE.search(jsonl_path)
    return m.group(1) if m else Path(jsonl_path).stem


# -- Indexing Operations ----------------------------------------------------

def scan_files(root, pattern):
    """{path: mtime} of the files under root matching pattern ("**/" for any depth); {} if root does not exist.

    Index entries: a flat folder of <uuid>.json. Codex shards its sessions by date
    (~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl) rather than Claude's per-project-slug layout, hence "**/".
    """
    d = Path(root)
    if not d.exists():
        return {}
    return {str(f): f.stat().st_mtime for f in d.glob(pattern) if f.is_file()}


def scan_history_jsonl():
    """Scan all local .jsonl history files. Returns {path: mtime}."""
    d = {}
    projects_dir = Path(PROJECTS_DIR)
    if not projects_dir.exists():
        return d
    for slug_dir in projects_dir.iterdir():
        if not slug_dir.is_dir():
            continue
        try:
            for f in slug_dir.iterdir():
                # agent-*.jsonl are subagent transcripts, not resumable sessions
                if f.is_file() and f.suffix == ".jsonl" and not f.name.startswith("agent-"):
                    d[str(f)] = f.stat().st_mtime
        except OSError:
            continue
    return d


# -- Agent backends ----------------------------------------------------------
# The seam between "how to find/parse/resolve/resume a session for this
# agent" (agent-specific) and everything else - search, filtering, ranking,
# fzf display, host coloring - which already operates purely on index-doc
# dicts and doesn't care where they came from.

class Backend(NamedTuple):
    name: str
    scan: Callable         # () -> {jsonl_path: mtime}
    parse: Callable        # (jsonl_path, warn=...) -> Transcript
    resume_cmd: Callable   # (doc, transcript or None, uuid, fork) -> the agent's command
    uuid_of: Callable      # jsonl_path -> uuid


def needs_reindex(uuid, jsonl_mtime, idx_mtime):
    """True unless both the transcript and agent-tracker's lifecycle.jsonl predate the index file.

    The lifecycle has to be checked separately: a session that only started or
    ended since the last run has a fresh lifecycle line but an untouched
    .jsonl, and its state in the index would otherwise never update.
    """
    if idx_mtime is None or jsonl_mtime > idx_mtime:
        return True
    try:
        return os.stat(lifecycle_path(uuid)).st_mtime > idx_mtime
    except OSError:
        return False


# Backend(name, scan, parse, resume_cmd, uuid_of), one per agent
BACKENDS = {
    # Claude names transcripts <uuid>.jsonl directly - the stem is the uuid
    "claude": Backend("claude", scan_history_jsonl, read_transcript, _claude_resume_cmd, lambda p: Path(p).stem),
}

if CODEX_ENABLED:
    BACKENDS["codex"] = Backend(
        "codex",
        # every .jsonl under ~/.codex/sessions/YYYY/MM/DD/ (scan_files)
        lambda: scan_files(CODEX_SESSIONS_DIR, "**/*.jsonl"),
        read_codex_transcript,
        # the `codex resume`/`codex fork` command (the folder is resume_shell_cmd's)
        lambda doc, transcript, uuid, fork: f"codex {'fork' if fork else 'resume'} {shlex.quote(uuid)}",
        _codex_uuid_of,
    )


# -- Commands ---------------------------------------------------------------

def plan_reindex(force=False, single_uuid="", max_sessions=0):
    """First moves the hidden entries (migrate_hidden_entries), then: which transcripts to (re)index,
    [(uuid, jsonl_path, backend)], plus counts.

    Only dates are read here (one stat per transcript, index file and lifecycle):
    ~4 ms for 3,014 transcripts (agent-tracker DESIGN §3, verified 2026-11-07).
    """
    migrate_hidden_entries()
    d_history = {}   # jsonl_path -> (mtime, backend)
    for backend in BACKENDS.values():
        for p, m in backend.scan().items():
            d_history[p] = (m, backend)
    if single_uuid:
        d_history = {p: (m, b) for p, (m, b) in d_history.items() if b.uuid_of(p) == single_uuid}
    d_index = {**scan_files(HIDDEN_INDEX_DIR, "*.json"),
               **scan_files(LOCAL_INDEX_DIR, "*.json")}   # by path: an entry in both counts twice
    idx_mtime_by_uuid = {Path(p).stem: mtime for p, mtime in d_index.items()}

    l_todo = []   # (uuid, jsonl_path, backend)
    d_counts = {"history": len(d_history), "index": len(d_index), "skipped": 0, "ignored": 0, "duplicates": 0}
    s_seen = set()
    for jsonl_path, (jsonl_mtime, backend) in d_history.items():
        if max_sessions and len(s_seen) >= max_sessions:
            break
        uuid = backend.uuid_of(jsonl_path)
        if uuid in s_seen:
            d_counts["duplicates"] += 1
            continue
        s_seen.add(uuid)
        # ignore_path_substrings (settings.json) excludes sessions of specific tools/directories (e.g. an
        # automated agent's own working space) without a code change.
        if any(s in jsonl_path for s in IGNORE_PATH_SUBSTRINGS):
            d_counts["ignored"] += 1
        elif not force and not needs_reindex(uuid, jsonl_mtime, idx_mtime_by_uuid.get(uuid)):
            d_counts["skipped"] += 1
        else:
            l_todo.append((uuid, jsonl_path, backend))
    d_counts["scanned"] = len(s_seen)
    return l_todo, d_counts


def run_reindex(l_todo, progress=False):
    """Index the given transcripts (index_one), 10 at a time. Returns (indexed, errors).

    progress: one [i/N] line per transcript, from the main thread.
    """
    if not l_todo:
        return 0, 0
    os.makedirs(LOCAL_INDEX_DIR, exist_ok=True)
    indexed = errors = 0
    with ThreadPoolExecutor(max_workers=min(10, len(l_todo))) as executor:
        d_uuid = {executor.submit(index_one, *t): t[0] for t in l_todo}   # future -> its uuid
        for future in as_completed(d_uuid):
            uuid = d_uuid[future]
            try:
                title, source = future.result()
            except Exception as e:
                errors += 1
                if progress:
                    eprint(f"    [{indexed + errors}/{len(l_todo)}] {uuid[:8]}  ERROR: {e}", flush=True)
                continue
            indexed += 1
            if progress:
                marker = TITLE_SOURCE_MARKERS[source]   # resolve_title gives one of its 4 keys
                print(f"    [{indexed + errors}/{len(l_todo)}] {uuid[:8]}  indexed {marker} {title[:60]}",
                      flush=True)
    return indexed, errors


def migrate_hidden_entries():
    """Move the entries of non-interactive sessions from indexes/ to indexes/hidden/ (once per machine).

    A marker file ends it; entries synced in later by an older ares are moved by the next `ares reindex --force`.
    """
    marker = os.path.join(HIDDEN_INDEX_DIR, ".migrated")
    if os.path.exists(marker) or not os.path.isdir(LOCAL_INDEX_DIR):
        return
    os.makedirs(HIDDEN_INDEX_DIR, exist_ok=True)
    for path in glob.glob(os.path.join(LOCAL_INDEX_DIR, "*.json")):
        doc = read_json(path)
        if doc is not None and doc.get("interactive") is False:
            os.replace(path, os.path.join(HIDDEN_INDEX_DIR, os.path.basename(path)))
    Path(marker).touch()


def cmd_reindex(max_sessions, force, single_uuid):
    """Build/refresh index JSON files from local JSONL files, with a progress log.

    Step 1: scan local .jsonl history files; Step 2: scan the .json index files;
    Step 3: decide what to reindex (3a), then reindex in parallel (3b).
    """
    mode = "force-reindex" if force else "reindex"
    if single_uuid:
        mode = f"reindex --uuid {single_uuid[:8]}"
    print(f"ares {VERSION} - {mode}" + (f" (max {max_sessions})" if max_sessions else ""), flush=True)
    os.makedirs(LOCAL_INDEX_DIR, exist_ok=True)

    l_todo, d_counts = plan_reindex(force, single_uuid, max_sessions)
    print(f"  Step 1: {d_counts['history']} .jsonl history files found", flush=True)
    print(f"  Step 2: {d_counts['index']} .json index files in local cache", flush=True)
    print(f"  Step 3a: {d_counts['scanned']} sessions scanned, {len(l_todo)} to reindex, "
          f"{d_counts['skipped']} up to date, {d_counts['ignored']} ignored, "
          f"{d_counts['duplicates']} duplicates", flush=True)

    indexed, errors = run_reindex(l_todo, progress=True)
    print(f"  Step 3b: indexed={indexed}, errors={errors}")


# -- Other machines ------------------------------------------------------------
# Since 2026-11-20 (the user): each search refreshes every remote host's own index there and copies it here one way
# (remote/<host>/), over one ssh call; a session only there resumes there, over ssh (resume_shell_cmd). Since
# 2026-11-22 the transcripts in the scope of ares sync are also copied here (below): those resume here; this pull
# stays the way to find and resume the others (older, non-interactive, too big).

def _pull_one(host):
    """Refresh the index on host and copy it into remote/<host>/ (replaced whole: a session gone there goes here
    too). True if the copy worked; on any failure the last copy stays."""
    try:
        res = subprocess.run(["ssh", *SSH_OPTS, host, PULL_REMOTE_CMD], timeout=PULL_TIMEOUT_S,
                             capture_output=True, stdin=subprocess.DEVNULL)
        if res.returncode != 0:
            return False
        dest = os.path.join(REMOTE_INDEX_DIR, host)
        new, old = dest + ".new", dest + ".old"
        for d in (new, old):
            shutil.rmtree(d, ignore_errors=True)   # a leftover of an interrupted pull
        os.makedirs(new)
        with tarfile.open(fileobj=io.BytesIO(res.stdout), mode="r:gz") as tf:
            for ti in tf:   # only flat <uuid>.json files: nothing in the archive can write elsewhere
                name = os.path.basename(ti.name)
                if ti.isfile() and ti.name in (name, "./" + name) and name.endswith(".json"):
                    with open(os.path.join(new, name), "wb") as f:
                        f.write(tf.extractfile(ti).read())
        if os.path.isdir(dest):
            os.replace(dest, old)
        os.replace(new, dest)
        shutil.rmtree(old, ignore_errors=True)
        return True
    except (OSError, subprocess.TimeoutExpired, tarfile.TarError):
        return False


def refresh_all(verbose):
    """Refresh this machine's index and pull every remote host's, all at once; an unreachable host keeps its
    last copy, and says so.

    This machine's: re-index only the transcripts newer than their index entry (agent-tracker DESIGN §3).
    Silent, and never fatal: a failure just means the search reads the index as it was.
    """
    with ThreadPoolExecutor(max_workers=len(REMOTE_HOSTS) or 1) as pool:
        d_pull = {host: pool.submit(_pull_one, host) for host in REMOTE_HOSTS}
        try:
            l_todo, d_counts = plan_reindex()
            indexed, errors = run_reindex(l_todo)
            log_verbose(f"refresh: {d_counts['scanned']} transcripts dated, {indexed} re-indexed, {errors} errors",
                        verbose)
        except Exception as e:   # the index stays as it was; the search still runs
            log_verbose(f"refresh skipped: {e}", verbose)
    for host, fut in d_pull.items():
        if not fut.result():
            eprint(f"\033[38;5;208m⚠ {host} unreachable: its sessions as of the last search\033[0m")


# -- Sync of transcripts between machines (DEV_DOC R6.7, D5) -----------------
# Since 2026-11-22 (the user): transcripts are copied both ways between this machine (the hub: the Mac, which can
# reach the others) and each of sync_hosts, so a session continues on either with a local `claude --resume <uuid>`.
# One ssh per host runs `ares sync-serve` there; both sides speak JSON lines, each optionally followed by raw bytes.
# A transcript is only ever created or extended (a temp file in its folder, then a rename): never shortened,
# replaced or deleted. Two copies of one uuid where neither is a prefix of the other (a fork) both stay as they are;
# the other side's is kept aside in conflicts/<host>/. A copy being written on its own side (live) is never written.
#
#   hub                                      host (ares sync-serve)
#   its scope (sync_manifest) ── manifest ─► its scope + the hub's uuids ──► {uuid: size, mtime, tail hash, live}
#   the plan (sync_decide)    ── hashes ──►  the hash of its file just before the hub's size (prefix check)
#   pulls                     ── get ─────►  the missing bytes
#   pushes                    ── put ─────►  written as the hub's are (write_grown)
#   reindex the copies        ── done ────►  reindex its copies, exit

SYNC_TAIL_W = 65536        # bytes hashed just before a size: equal on both sides = one file is a prefix of the other
SYNC_CHUNK = 1 << 20
SYNC_HELLO_TIMEOUT_S = 60  # the host's scope: a reindex there first (~0.4 s on the NAS, 2026-11-20)
SYNC_MIN_RATE = 1e6        # bytes/s assumed for the transfer deadline (LAN to the NAS: 44 MB/s, 2026-11-22)


class SyncError(Exception):
    pass


def sync_trees():
    """{tree: (its root, its backend)}: Claude's projects/ (shared by every Claude account: account-*/projects is a
    link to it) and, when Codex is enabled here, Codex's sessions/."""
    roots = {"claude": PROJECTS_DIR, "codex": CODEX_SESSIONS_DIR}
    return {name: (roots[name], b) for name, b in BACKENDS.items()}


def tree_path(tree, rel):
    """The absolute path of a transcript named by the other side; SyncError for anything outside the tree."""
    root = sync_trees().get(tree, (None,))[0]
    p = os.path.normpath(os.path.join(root or "/nonexistent", rel))
    if not root or not p.startswith(os.path.normpath(root) + os.sep) or not p.endswith(".jsonl"):
        raise SyncError(f"refused path {tree}:{rel}")
    return p


def tail_hash(f, size):
    """The hash of the SYNC_TAIL_W bytes before size."""
    f.seek(max(0, size - SYNC_TAIL_W))
    return hashlib.sha256(f.read(size - max(0, size - SYNC_TAIL_W))).hexdigest()


def file_entry(path):
    """size (up to the last newline: a line being written is not copied), mtime_ns, tail (tail_hash at size)."""
    with open(path, "rb") as f:
        st = os.fstat(f.fileno())
        size = pos = st.st_size
        while pos > 0:
            n = min(SYNC_TAIL_W, pos)
            f.seek(pos - n)
            i = f.read(n).rfind(b"\n")
            if i >= 0:
                size = pos - n + i + 1
                break
            pos -= n
        else:
            size = 0
        return {"size": size, "mtime_ns": st.st_mtime_ns, "tail": tail_hash(f, size)}


def proc_starts():
    """pid -> start time (epoch s) of every process, from one ps call ({} if ps fails)."""
    try:
        out = subprocess.run(["ps", "-A", "-o", "pid=,lstart="], capture_output=True, text=True, timeout=10,
                             env={**os.environ, "LC_ALL": "C"}).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    d = {}
    for line in out.splitlines():
        pid, _, lstart = line.strip().partition(" ")
        try:
            d[int(pid)] = time.mktime(time.strptime(lstart.strip(), "%a %b %d %H:%M:%S %Y"))
        except ValueError:
            pass
    return d


def live_kind(uuid, mtime_ns, d_procs):
    """"running": agent-tracker's open start of this session has its process alive (same start time, 2 s slack, as
    session_start.py); "recent": the transcript changed in the last sync_live_seconds; None: not live."""
    st = open_start(read_lifecycle(uuid))
    pid = st.get("pid") if st else None
    t = d_procs.get(pid) if isinstance(pid, int) else None
    if t is not None and (not st.get("pid_start") or abs(t - int(st["pid_start"])) <= 2):
        return "running"
    return "recent" if time.time() - mtime_ns / 1e9 < SYNC_LIVE_S else None


def sync_manifest(since_days, max_mb, s_named, s_also, l_trees, refresh=True):
    """This machine's transcripts in the scope of a sync, {uuid: entry}, and how many were left out for their size.

    In scope: an interactive session (its index entry in indexes/, not hidden/) modified in the last since_days and
    not bigger than max_mb; a named uuid (--uuid) whatever its kind, age or size; and every uuid of s_also found here
    (the other side's scope: both sides compare the same sessions). Entry: tree, path (relative to the tree's root),
    file_entry's size / mtime_ns / tail, live (live_kind)."""
    if refresh:
        try:
            run_reindex(plan_reindex()[0])   # the interactive flag of every session, up to date
        except Exception:
            pass
    cutoff = time.time() - since_days * 86400
    d_procs = proc_starts()
    d, n_big = {}, 0
    for tree, (root, backend) in sync_trees().items():
        if tree not in l_trees:
            continue
        for p, mtime in backend.scan().items():
            uuid = backend.uuid_of(p)
            if any(s in p for s in IGNORE_PATH_SUBSTRINGS):
                continue
            if uuid not in s_named and uuid not in s_also:
                if mtime < cutoff or not os.path.exists(os.path.join(LOCAL_INDEX_DIR, uuid + ".json")):
                    continue
                if os.path.getsize(p) > max_mb * 1e6:
                    n_big += 1
                    continue
            try:
                e = file_entry(p)
            except OSError:
                continue
            d[uuid] = {"tree": tree, "path": os.path.relpath(p, root), **e,
                       "live": live_kind(uuid, e["mtime_ns"], d_procs)}
    return d, n_big


def copy_n(src, dst, n):
    """Copy exactly n bytes from src to dst (None: read and drop them); SyncError if src ends first."""
    while n > 0:
        b = src.read(min(SYNC_CHUNK, n))
        if not b:
            raise SyncError("the stream ended in a transfer")
        if dst:
            dst.write(b)
        n -= len(b)
    return b


def write_grown(path, base, base_mtime_ns, src, n, mtime_ns):
    """Write path as its first base bytes followed by n bytes read from src, through a temp file in its folder and a
    rename (an interruption leaves path as it was). base -1: a new transcript (path must not exist). Reads all n bytes
    even when it refuses (the stream stays in step). Returns None, or why it refused: path changed since the plan,
    the new file would not be longer, or the bytes do not end with a complete line."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".ares-tmp")   # not *.jsonl
    err = st = None
    try:
        with open(tmp, "wb") as out:
            os.chmod(tmp, 0o600)   # transcripts are private
            if base >= 0:
                try:
                    with open(path, "rb") as f:
                        st = os.fstat(f.fileno())
                        if st.st_mtime_ns != base_mtime_ns or st.st_size < base:
                            err = "changed since the plan"
                        else:
                            copy_n(f, out, base)
                except OSError as e:
                    err = f"unreadable: {e}"
            elif os.path.exists(path):
                err = "exists already"
            last = copy_n(src, None if err else out, n)
            out.flush()
            os.fsync(out.fileno())
        if err:
            return err
        if not last.endswith(b"\n"):
            return "the bytes received do not end a line"
        if base >= 0:
            st2 = os.stat(path)
            if (st2.st_size, st2.st_mtime_ns) != (st.st_size, st.st_mtime_ns):
                return "changed while copying"
            if base + n <= st.st_size:
                return "the result would not be longer"
        elif os.path.exists(path):
            return "exists already"
        os.utime(tmp, ns=(mtime_ns, mtime_ns))   # the source's: last active, Claude's cleanupPeriodDays
        os.replace(tmp, path)
        return None
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


class Peer:
    """One side of the sync protocol: JSON lines, each optionally followed by raw bytes."""
    def __init__(self, rfile, wfile):
        self.r, self.w = rfile, wfile

    def send(self, d, path=None, offset=0, n=0):
        self.w.write(json.dumps(d).encode() + b"\n")
        if path:
            with open(path, "rb") as f:
                f.seek(offset)
                copy_n(f, self.w, n)
        self.w.flush()

    def recv(self):
        line = self.r.readline()
        if not line.endswith(b"\n"):
            raise SyncError("the connection closed")
        return json.loads(line)


def codex_index_lines():
    """The complete lines of Codex's session_index.jsonl ([] without one)."""
    try:
        data = Path(CODEX_SESSION_INDEX_FILE).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    return [line for line in data.split("\n")[:-1] if line.strip()]


def index_lines_missing(l_have, l_other):
    """The lines of l_other to append to l_have: per id, those newer (updated_at) than the newest l_have has, in
    updated_at order (Codex reads the latest line per id)."""
    def parse(line):
        try:
            d = json.loads(line)
            return (d.get("id"), str(d.get("updated_at") or "")) if isinstance(d, dict) and d.get("id") else None
        except json.JSONDecodeError:
            return None
    newest = {}
    for line in l_have:
        k = parse(line)
        if k:
            newest[k[0]] = max(newest.get(k[0], ""), k[1])
    l_new = [(k[1], line) for line in l_other for k in [parse(line)] if k and k[1] > newest.get(k[0], "")]
    return [line for _, line in sorted(l_new)]


def append_codex_index(l_lines):
    """Append lines to Codex's session_index.jsonl (never rewritten); None, or why not."""
    if not l_lines:
        return None
    try:
        with open(CODEX_SESSION_INDEX_FILE, "ab+") as f:
            f.seek(0, os.SEEK_END)
            if f.tell():
                f.seek(-1, os.SEEK_END)
                if f.read(1) != b"\n":
                    return "its last line is being written"
            f.write(("\n".join(l_lines) + "\n").encode())
    except OSError as e:
        return str(e)
    return None


def reindex_paths(l_items):
    """Re-index the transcripts just written, [(tree, absolute path, uuid)] (their mtime is the source's, so the date
    rule of plan_reindex would miss them)."""
    run_reindex([(u, p, sync_trees()[t][1]) for t, p, u in l_items if t in sync_trees()])


def cmd_sync_serve():
    """The host side (ssh <host> ares sync-serve): answers the hub on stdin/stdout until "done"."""
    peer = Peer(sys.stdin.buffer, sys.stdout.buffer)
    sys.stdout = sys.stderr   # nothing else may write on the protocol's stream
    l_written = []
    while True:
        try:
            m = peer.recv()
        except SyncError:
            return 1
        op = m.get("op")
        try:
            if op == "manifest":
                d, n_big = sync_manifest(m["since_days"], m["max_mb"], set(m["named"]), set(m["also"]), m["trees"])
                peer.send({"trees": [t for t in m["trees"] if t in sync_trees()], "files": d, "too_big": n_big,
                           "codex_index": codex_index_lines() if "codex" in sync_trees() else []})
            elif op == "hashes":
                l_h = []
                for tree, rel, size in m["items"]:
                    with open(tree_path(tree, rel), "rb") as f:
                        l_h.append(tail_hash(f, size))
                peer.send({"hashes": l_h})
            elif op == "get":
                p = tree_path(m["tree"], m["path"])
                n = m["b"] - m["a"]
                if os.path.getsize(p) < m["b"]:
                    raise SyncError(f"{m['path']} is shorter than planned")
                peer.send({"n": n}, p, m["a"], n)
            elif op == "put":
                p = tree_path(m["tree"], m["path"])
                err = write_grown(p, m["base"], m["base_mtime_ns"], peer.r, m["n"], m["mtime_ns"])
                if not err:
                    l_written.append((m["tree"], p, m["uuid"]))
                peer.send({"error": err})
            elif op == "append_index":
                peer.send({"error": append_codex_index(m["lines"])})
            elif op == "done":
                reindex_paths(l_written)
                peer.send({"ok": True})
                return 0
            else:
                peer.send({"error": f"unknown op {op}"})
        except (OSError, SyncError, KeyError, TypeError, ValueError) as e:
            if op == "put":   # its bytes were not read: the stream is out of step
                return 1
            peer.send({"error": str(e)})


def fmt_bytes(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1000 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000


def sync_decide(l, r, prefix):
    """What to do with one uuid, l and r its entries here and there (None: absent), prefix whether the shorter is a
    prefix of the longer. One of: pull, push (create or extend the other side), same, conflict, live (the copy to
    write is being written on its side), duplicate (running on both machines)."""
    if l and r and l["live"] == "running" and r["live"] == "running":
        return "duplicate"
    src, dst, kind = (r, l, "pull") if not l or (r and r["size"] > l["size"]) else (l, r, "push")
    if dst and dst["size"] == src["size"]:
        return "same" if dst["tail"] == src["tail"] else "conflict"
    if dst and not prefix:
        return "conflict"
    if not src["size"]:
        return "same"
    return "live" if dst and dst["live"] else kind


def sync_host(host, since_days, max_mb, s_named, l_trees, dry_run):
    """Sync this machine with one host (R6.7): print the plan, then (unless dry_run) do it. Returns a dict: status
    (ok, unreachable, error), the counts, the uuids running there (remote_running), the line for the summary."""
    t0 = time.time()
    errf = tempfile.TemporaryFile()
    proc = subprocess.Popen(["ssh", *SSH_OPTS, host, SYNC_SERVE_CMD], stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=errf)
    killer = threading.Timer(SYNC_HELLO_TIMEOUT_S, proc.kill)
    killer.start()
    peer = Peer(proc.stdout, proc.stdin)
    c = {k: 0 for k in ("pull", "push", "pull_bytes", "push_bytes", "conflict", "live", "duplicate", "failed",
                        "compared", "too_big")}
    res = {"status": "ok", "counts": c, "remote_running": set()}
    l_mine = []   # (tree, path, uuid) written here
    try:
        d_l, n_big = sync_manifest(since_days, max_mb, s_named, set(), l_trees)
        peer.send({"op": "manifest", "since_days": since_days, "max_mb": max_mb, "named": sorted(s_named),
                   "also": sorted(d_l), "trees": l_trees})
        m = peer.recv()
        trees = m["trees"]
        d_r = {u: e for u, e in m["files"].items() if e["tree"] in trees}
        d_l.update(sync_manifest(since_days, max_mb, s_named, set(d_r), l_trees, refresh=False)[0])
        d_l = {u: e for u, e in d_l.items() if e["tree"] in trees}
        c["too_big"] = n_big + m["too_big"]
        res["remote_running"] = {u for u, e in d_r.items() if e["live"] == "running"}
        # prefix checks: the longer side's hash just before the shorter one's size, against the shorter's tail
        l_ask = [u for u in d_l if u in d_r and 0 < d_l[u]["size"] < d_r[u]["size"]]
        peer.send({"op": "hashes", "items": [[d_r[u]["tree"], d_r[u]["path"], d_l[u]["size"]] for u in l_ask]})
        d_prefix = dict(zip(l_ask, (h == d_l[u]["tail"] for u, h in zip(l_ask, peer.recv()["hashes"]))))
        for u in d_l:
            if u in d_r and d_l[u]["size"] > d_r[u]["size"]:
                with open(tree_path(d_l[u]["tree"], d_l[u]["path"]), "rb") as f:
                    d_prefix[u] = tail_hash(f, d_r[u]["size"]) == d_r[u]["tail"]
        l_plan = []
        for u in sorted(set(d_l) | set(d_r)):
            l, r = d_l.get(u), d_r.get(u)
            c["compared"] += 1
            kind = sync_decide(l, r, d_prefix.get(u, True))   # absent: one side only, or an empty one
            if kind != "same":
                l_plan.append((kind, u, l, r))
        # the plan, printed
        for kind, u, l, r in l_plan:
            e = r if kind == "pull" else l if kind == "push" else (l or r)
            where = f"{e['tree']}  {e['path']}"
            if kind in ("pull", "push"):
                src, dst = (r, l) if kind == "pull" else (l, r)
                base = dst["size"] if dst else 0
                c[kind] += 1
                c[kind + "_bytes"] += src["size"] - base
                arrow = "↓" if kind == "pull" else "↑"
                print(f"{host}  {arrow} {'extend' if dst else 'new':6}  {where}  {fmt_bytes(base)} → "
                      f"{fmt_bytes(src['size'])}" + (f" (live {'there' if kind == 'pull' else 'here'}: its complete lines so far)"
                                                  if src["live"] else ""))
            elif kind == "conflict":
                c["conflict"] += 1
                print(f"\033[38;5;208m{host}  ⚠ CONFLICT  {where}: here {fmt_bytes(l['size'])}, there "
                      f"{fmt_bytes(r['size'])}, neither is a prefix of the other (both continued); both kept, "
                      f"theirs copied to {os.path.join(CONFLICTS_DIR, host)}/\033[0m")
            elif kind == "duplicate":
                c["duplicate"] += 1
                print(f"\033[38;5;208m{host}  ⚠ DUPLICATE SESSION on two machines: {u} is running here and on "
                      f"{host}; nothing copied\033[0m")
            else:
                c["live"] += 1
                print(f"{host}  live, skipped  {where} (being written on {'this machine' if l and l['live'] else host})")
        killer.cancel()
        killer = threading.Timer(SYNC_HELLO_TIMEOUT_S + (c["pull_bytes"] + c["push_bytes"]) / SYNC_MIN_RATE,
                                 proc.kill)
        killer.start()
        if not dry_run:
            for kind, u, l, r in l_plan:
                if kind == "pull" or (kind == "conflict" and r["size"]):
                    p = (os.path.join(CONFLICTS_DIR, host, r["tree"], r["path"]) + f".{r['size']}"
                         if kind == "conflict" else os.path.join(sync_trees()[r["tree"]][0], l["path"] if l else r["path"]))
                    if kind == "conflict" and os.path.exists(p):
                        continue   # kept at an earlier sync
                    base = l["size"] if l and kind == "pull" else 0
                    peer.send({"op": "get", "tree": r["tree"], "path": r["path"], "a": base, "b": r["size"]})
                    h = peer.recv()
                    if "n" not in h:   # nothing was sent: the stream is in step
                        c["failed"] += 1
                        print(f"{host}  ✗ {r['path']}: not sent: {h.get('error')}")
                        continue
                    err = write_grown(p, base if l and kind == "pull" else -1, l["mtime_ns"] if l else 0, proc.stdout,
                                      h["n"], r["mtime_ns"])
                    if err:
                        c["failed"] += 1
                        print(f"{host}  ✗ {r['path']}: not written here: {err}")
                    elif kind == "pull":
                        l_mine.append((r["tree"], p, u))
                elif kind == "push":
                    base = r["size"] if r else 0
                    peer.send({"op": "put", "tree": l["tree"], "path": r["path"] if r else l["path"], "uuid": u,
                               "base": base if r else -1, "base_mtime_ns": r["mtime_ns"] if r else 0,
                               "mtime_ns": l["mtime_ns"], "n": l["size"] - base},
                              tree_path(l["tree"], l["path"]), base, l["size"] - base)
                    err = peer.recv().get("error")
                    if err:
                        c["failed"] += 1
                        print(f"{host}  ✗ {l['path']}: not written there: {err}")
            if "codex" in trees:   # Codex's titles: the newer lines of each side appended to the other's
                l_here, l_there = codex_index_lines(), m["codex_index"]
                append_codex_index(index_lines_missing(l_here, l_there))
                peer.send({"op": "append_index", "lines": index_lines_missing(l_there, l_here)})
                peer.recv()
        peer.send({"op": "done"})
        peer.recv()
        reindex_paths(l_mine)
    except (OSError, SyncError, KeyError, TypeError, ValueError) as e:
        proc.kill()
        proc.wait()
        try:
            proc.stdin.close()   # its unsent bytes dropped now, not as a "BrokenPipeError" at exit
        except OSError:
            pass
        errf.seek(0)
        l_err = [ln for ln in errf.read().decode(errors="replace").splitlines()
                 if ln.strip() and not ln.startswith("**")]   # ssh's post-quantum notice
        res["status"] = "unreachable" if proc.returncode == 255 and not c["compared"] else "error"
        why = l_err[-1] if l_err else str(e)
        res["line"] = f"{host} {'unreachable' if res['status'] == 'unreachable' else 'failed'}: {why}"
        eprint(f"\033[38;5;208m⚠ {res['line']}\033[0m")
        return res
    finally:
        killer.cancel()
    proc.stdin.close()
    proc.wait()
    l_parts = [f"{n} {w}" for n, w in ((c["pull"], f"↓ ({fmt_bytes(c['pull_bytes'])})"),
                                        (c["push"], f"↑ ({fmt_bytes(c['push_bytes'])})"),
                                        (c["conflict"], "conflict(s)"), (c["duplicate"], "DUPLICATE SESSION(S)"),
                                        (c["live"], "live, skipped"), (c["failed"], "failed"),
                                        (c["too_big"], f"over {max_mb} MB, left out")) if n]
    res["line"] = (f"{host} {' · '.join(l_parts) or 'up to date'} ({c['compared']} compared, "
                   f"{time.time() - t0:.1f} s{', dry run' if dry_run else ''})")
    if c["failed"]:
        res["status"] = "error"
    return res


def sync_lock(wait_s=0):
    """The lock of ares sync (data/sync.lock): an open file holding it, or None when another sync holds it."""
    os.makedirs(ARES_DATA_DIR, exist_ok=True)
    f = open(SYNC_LOCK, "a")
    deadline = time.time() + wait_s
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return f
        except OSError:
            if time.time() >= deadline:
                f.close()
                return None
            time.sleep(0.5)


def cmd_sync(hosts, dry_run, since_days, max_mb, s_named, agent):
    """ares sync: each host in turn (hub and spoke: what one host sent reaches the next in the same run).
    Exit 0; 3 a host unreachable; 1 an error; 5 another sync running. The last line starts with "sync:"."""
    l_hosts = hosts or SYNC_HOSTS
    if not l_hosts:
        eprint("ERROR: no host: set sync_hosts in " + SETTINGS_PATH + " or give --host")
        return 1
    lock = sync_lock()
    if not lock:
        print("sync: another ares sync is running")
        return 5
    l_trees = [agent] if agent else list(sync_trees())
    l_res = [sync_host(h, since_days, max_mb, s_named, l_trees, dry_run) for h in l_hosts]
    print("sync: " + "; ".join(r["line"] for r in l_res))
    l_status = [r["status"] for r in l_res]
    return 1 if "error" in l_status else 3 if "unreachable" in l_status else 0


# -- Resume -----------------------------------------------------------------

def pull_newer_copy(uuid, doc):
    """R6.7: a session that has a copy here but is newer on a sync host (doc is that host's) is pulled first
    (ares sync --host <host> --uuid <uuid>), then resumed here; the pull failing, it resumes there, over ssh. Running
    there right now: says so (resuming it here too makes two processes continue one session). Returns the doc to
    resume."""
    host = doc.get("_host")
    if not host or host not in SYNC_HOSTS:
        return doc
    def local_doc():
        return next((d for d in (load_index_doc(os.path.join(p, f"{uuid}.json"), None)
                                 for p in (LOCAL_INDEX_DIR, HIDDEN_INDEX_DIR)) if d and not d["_source_missing"]), None)
    if not local_doc():
        return doc
    eprint(f"The copy on {host} is newer than this machine's: ares sync --host {host} --uuid {uuid} ...")
    lock = sync_lock(wait_s=60)
    res = sync_host(host, 0, 0, {uuid}, list(sync_trees()), False) if lock else {"status": "busy", "line": "busy"}
    if lock:
        lock.close()
    if res["status"] != "ok" or res["counts"]["failed"] or res["counts"]["conflict"]:
        eprint(f"\033[38;5;208m⚠ not pulled ({res['line']}): resuming it on {host}\033[0m")
        return doc
    if uuid in res["remote_running"]:
        eprint(f"\033[38;5;208m⚠ DUPLICATE SESSION on two machines: {uuid} is running on {host} too\033[0m")
    return local_doc()   # re-indexed by sync_host


def cmd_resume(opts, fork, print_cmd):
    """Find and resume a session.

    print_cmd builds the exact command and prints it to stdout (nothing else)
    instead of exec'ing it - a scriptable, non-interactive seam for tests that
    need to assert on resume/fork command construction without ever launching
    either agent's TUI.
    """
    refresh_all(opts.verbose)
    if opts.uuid:
        doc = find_by_uuid(opts.uuid)
        if not doc:
            eprint(f"ERROR: no indexed session matches uuid '{opts.uuid}'.")
            sys.exit(1)
        uuid = doc.get("session_id", opts.uuid)
    else:
        uuid, doc = pick_session(opts)

    if doc.get("_source_missing", False):
        # Its transcript is gone from this machine (deleted by hand, or by Claude Code after cleanupPeriodDays):
        # nothing to resume. The index entry still holds the whole conversation.
        eprint(f"ERROR: the transcript of session {uuid} is gone from this machine: it cannot be resumed.\n"
               f"  Its conversation is still in the index: {os.path.join(LOCAL_INDEX_DIR, uuid + '.json')}")
        sys.exit(1)

    doc = pull_newer_copy(uuid, doc)
    backend = BACKENDS.get(doc.get("agent_type") or "claude", BACKENDS["claude"])
    host = doc.get("_host")
    initial_wd = doc.get("initial_working_dir", "")
    latest_wd = doc.get("latest_working_dir", "")

    # Re-read the transcript when it is here: it holds the permission mode, and a title that may be newer than the
    # indexed one if the session was renamed since. Another machine's session: the index's.
    jsonl_path = "" if host else _resolve_jsonl_path(doc.get("jsonl_path", ""))
    transcript = backend.parse(jsonl_path, warn=False) if jsonl_path else None
    perm_mode = transcript.permission_mode if transcript else doc.get("permission_mode")
    title = (transcript.title if transcript else None) or doc.get("custom_title", "")
    working_dir = resume_dir(doc)
    cmd = resume_shell_cmd(doc, backend.resume_cmd(doc, transcript, uuid, fork))

    if print_cmd:
        print(cmd)
        return

    print("")
    print(f"Title:              {title or '(not set)'}")
    print(f"UUID:               {uuid}")
    print(f"Machine:            {host or 'this one'}")
    print(f"Original WD:        {initial_wd}")
    print(f"Latest WD:          {latest_wd or initial_wd}")
    print(f"JSONL file:         {doc.get('jsonl_path') if host else jsonl_path or '(unknown)'}")
    print(f"Permission mode:    {perm_mode or '(unknown)'}")
    print(f"Folder:             {working_dir}")
    if not host and working_dir != (latest_wd or initial_wd or working_dir):
        print("\033[33mThe folder it last ran in no longer exists here: resuming in the current folder.\033[0m")
    print(f"Command:            {cmd}")
    print("")
    print(f"{'Forking' if fork else 'Resuming'} {'on ' + host if host else ''} in {working_dir} ...")
    os.execv("/bin/bash", ["/bin/bash", "-c", cmd])


# -- Crash restore: ares tmux (agent-tracker IMPLEMENTATION.md §5) -----------
#
# After a crash, put back what ran at the end of the previous boot, read from
# agent-tracker's files only (no snapshot of our own):
#
#   prev boot   = the newest boot_ts in data/sessions/*/ that is not this boot
#   candidates  = Claude sessions whose NEWEST start line is of that boot and was not followed by a clean exit
#                 (killed_start: no end, or an end with reason "other" = tmux or the terminal died under it);
#                 --this-boot: the same, for this boot, process no longer running (tmux died, no reboot)
#   one per pane_id: the newest last_seen.ts wins (the pane was reused)
#   stale       = no last_seen.json of that boot, or last_seen.ts more than 2 min older than the
#                 boot's newest last_seen.ts (it had stopped ticking: killed before the crash);
#                 restored only with --all
#   per tmux session (never one that already exists): its windows (index, name, size),
#   as many panes as the saved window_layout has, select-layout, then in each Claude pane
#   `cd <dir> && claude --resume <uuid>`; plain panes are shells in ~ (their folder is not recorded);
#   then one iTerm2 tab per restored tmux session (AppleScript), unless --no-iterm.
#
# Only windows that held a Claude session are known (only Claude sessions write last_seen.json).

CLAUDE_START_WAIT_S = 2.0   # ares tmux: how long a pane gets to start claude before it is checked
SHELLS = {"bash", "zsh", "sh", "dash", "fish", "ksh", "tcsh"}   # a pane still on one of these is not running claude
STALE_AFTER_S = 120    # agent-tracker IMPLEMENTATION.md §5: "more than 2 min older"
SAME_BOOT_S = 60       # macOS shifts kern.boottime by a few seconds when the clock is stepped
LAYOUT_CELL_RE = re.compile(r"(\d+)x(\d+),\d+,\d+(?:,(\d+))?")   # WxH,X,Y[,pane number]


def current_boot_ts():
    """This boot's start (epoch s): $AGENT_TRACKER_BOOT_TS (tests), sysctl kern.boottime, or /proc/stat btime."""
    if os.environ.get("AGENT_TRACKER_BOOT_TS"):
        return int(os.environ["AGENT_TRACKER_BOOT_TS"])
    if sys.platform == "darwin":
        m = re.search(r"sec = (\d+)", run_text(["sysctl", "-n", "kern.boottime"]).stdout)
        return int(m.group(1)) if m else 0
    for line in Path("/proc/stat").read_text().splitlines():
        if line.startswith("btime "):
            return int(line.split()[1])
    return 0


def layout_cells(layout):
    """'b25f,208x52,0,0{104x52,0,0,1,103x52,105,0,2}' -> ((208, 52), [1, 2]): window size, pane numbers in pane order."""
    # The cells come after the checksum and its comma; no comma (or no layout): no cell
    l_cells = LAYOUT_CELL_RE.findall((layout or "").partition(",")[2])
    if not l_cells:
        return None, []
    size = (int(l_cells[0][0]), int(l_cells[0][1]))
    return size, [int(n) for _, _, n in l_cells if n]


def same_boot(a, b):
    """Whether two boot_ts are of one boot (SAME_BOOT_S apart at most); never when one is missing."""
    return a is not None and b is not None and abs(int(a) - int(b)) <= SAME_BOOT_S


def _fmt_ts(ts):
    try:
        return datetime.fromtimestamp(int(ts), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except (TypeError, ValueError, OverflowError, OSError):
        return "?"


def tmux_plan(include_stale, this_boot):
    """Read agent-tracker's files and decide what to restore (no tmux call).

    this_boot: the tmux server died without a reboot: candidates are this boot's Claude sessions
    whose process is gone without a clean exit (killed_start), instead of the previous boot's.

    Returns {"boot_ts", "newest_ts", "sessions": {name: {window_index: window}}, "stale": [row],
    "outside": [row]} or {"boot_ts": None} when there is no previous boot. A row is one Claude
    session: {"uuid", "seen", "start", "ts", "pane_id", "cmd"}; a window: {"name", "layout", "size",
    "panes": [row or None]} (None = a plain shell).
    """
    boot_now = current_boot_ts()

    l_rows = []
    for folder in sorted(glob.glob(os.path.join(TRACKER_SESSIONS_DIR, "*", ""))):
        uuid = os.path.basename(folder.rstrip("/"))
        seen = read_json(os.path.join(folder, "last_seen.json")) or {}
        l_events = read_lifecycle(uuid)
        l_rows.append({"uuid": uuid, "seen": seen, "events": l_events,
                       "boots": [seen.get("boot_ts")] + [e.get("boot_ts") for e in l_events]})

    if this_boot:
        prev = boot_now
    else:
        # every boot named in agent-tracker's files, but this one: the newest is the previous boot
        l_boots = [int(b) for r in l_rows for b in r["boots"]
                   if isinstance(b, (int, float)) and not same_boot(b, boot_now)]
        if not l_boots:
            return {"boot_ts": None}
        prev = max(l_boots)

    l_cand = []
    for r in l_rows:
        start = killed_start(r["events"], prev)   # both modes: see its docstring; it is of that boot
        if not start or (start.get("agent") or "claude") != "claude":
            continue
        if this_boot and pid_alive(start.get("pid")):
            continue   # still running: nothing to restore (after a reboot, a pid is a new process: not checked)
        seen = r["seen"] if same_boot(r["seen"].get("boot_ts"), prev) else {}
        r["start"], r["seen"] = start, seen
        r["ts"] = int(seen.get("ts") or start.get("ts") or 0)
        r["pane_id"] = seen.get("pane_id") or start.get("pane_id")
        # `cd <dir> && claude --resume <uuid>`, in the last folder the session ran in (as `ares resume`):
        # agent-tracker's start cwd of that run, else its last seen cwd, else ~ (any folder works: resume_dir).
        wd = start.get("cwd") or seen.get("cwd")
        if not (wd and os.path.isdir(wd)):
            wd = HOME
        r["cmd"] = f"cd {shlex.quote(wd)} && claude --resume {shlex.quote(r['uuid'])}"
        l_cand.append(r)

    if not this_boot:   # --this-boot: the snapshot may already show the tmux server started after the death
        snap = read_snapshot(prev)
        if snap:
            return snapshot_plan(prev, snap, l_cand)

    # The moment of the crash, roughly: the newest tick among the candidates (this boot also holds live ones).
    newest_ts = max((int(r["seen"]["ts"]) for r in l_cand if r["seen"].get("ts")), default=0)

    d_by_pane = {}   # pane_id -> its newest row
    l_outside = []
    for r in l_cand:
        r["stale"] = not r["seen"].get("ts") or r["ts"] < newest_ts - STALE_AFTER_S
        pane_id = r["pane_id"]
        if not pane_id:
            l_outside.append(r)
        elif pane_id not in d_by_pane or r["ts"] > d_by_pane[pane_id]["ts"]:
            d_by_pane[pane_id] = r

    d_sessions = {}   # tmux session -> {window_index: window}
    l_stale = []
    for pane_id, r in sorted(d_by_pane.items(), key=lambda kv: -kv[1]["ts"]):   # newest first
        if r["stale"] and not include_stale:
            l_stale.append(r)
            continue
        seen = r["seen"]
        session, window, _ = split_pane(seen.get("pane") or r["start"].get("pane"))
        session = seen.get("tmux_session") or session
        try:
            widx = int(seen["window_index"] if seen.get("window_index") is not None else window)
        except (TypeError, ValueError):
            widx = 0
        if not session:
            l_outside.append(r)
            continue
        w = d_sessions.setdefault(session, {}).setdefault(widx, {"name": None, "layout": None, "claude": {}})
        if w["name"] is None:   # rows come newest first: the newest one gives the window's name and layout
            w["name"], w["layout"] = seen.get("window_name"), seen.get("window_layout")
        w["claude"][pane_id] = r

    for d_windows in d_sessions.values():
        for w in d_windows.values():
            # One pane per cell of the saved layout, in pane order; a cell with no Claude session is a plain shell.
            w["size"], l_numbers = layout_cells(w["layout"])
            d_claude = dict(w.pop("claude"))
            w["panes"] = [d_claude.pop(f"%{n}", None) for n in l_numbers]
            if d_claude:   # a Claude pane the saved layout does not hold (layout older than the pane): add it
                w["panes"] += sorted(d_claude.values(), key=lambda r: int(r["seen"].get("pane_index") or 0))
                w["layout"] = "tiled"
            if not w["panes"]:
                w["panes"], w["layout"] = [None], None

    return {"boot_ts": prev, "newest_ts": newest_ts, "sessions": d_sessions, "stale": l_stale,
            "outside": l_outside}


def read_snapshot(boot_ts):
    """agent-tracker's terminal snapshot of that boot (its FOR_READERS.md §4, rule 18), or None.

    The newest data/snapshots/<boot_ts>.tsv whose name is that boot (macOS may shift boot_ts by a few seconds).
    Returns {"path", "ts" (newest pane row), "panes": [{"session", "window_index", "pane_index", "pane_id",
    "command", "cwd", "layout", "window_name"}], "clients": {tty: tmux session}, "iterm": [{"window", "tab",
    "tty", "bounds"}]}. A line without its final newline is ignored."""
    l_files = []
    for f in glob.glob(os.path.join(TRACKER_SNAPSHOTS_DIR, "*.tsv")):
        name = os.path.basename(f)[:-4]   # <boot_ts>
        if name.isdigit() and same_boot(int(name), boot_ts):
            l_files.append(f)
    if not l_files:
        return None
    path = max(l_files, key=os.path.getmtime)
    d = {"path": path, "ts": 0, "panes": [], "clients": {}, "iterm": []}
    try:
        l_lines = open(path, encoding="utf-8", errors="replace").readlines()
    except OSError:
        return None
    for line in l_lines:
        f = line.rstrip("\n").split("\t")
        if not line.endswith("\n") or len(f) < 3 or not f[0].isdigit():
            continue
        if f[2] == "pane" and len(f) >= 11 and f[4].isdigit() and f[5].isdigit():
            d["ts"] = max(d["ts"], int(f[0]))
            d["panes"].append({"session": f[3], "window_index": int(f[4]), "pane_index": int(f[5]), "pane_id": f[6],
                               "command": f[7].lstrip("-"), "cwd": f[8], "layout": f[9],
                               "window_name": "\t".join(f[10:])})
        elif f[2] == "client" and len(f) >= 5:
            d["clients"][f[3]] = f[4]
        elif f[2] == "iterm" and len(f) >= 8 and f[3].isdigit() and f[5].isdigit():
            d["iterm"].append({"window": int(f[3]), "tab": int(f[5]), "tty": f[6], "bounds": f[7]})
    return d if d["panes"] else None


def snapshot_plan(prev, snap, l_cand):
    """tmux_plan from the previous boot's snapshot: every tmux session, window and pane it lists. A pane gets
    `claude --resume` when a candidate (killed_start in that boot) has its pane_id and the pane's command was not
    a shell (Claude was still running there); else a shell in its folder. No stale rule. Candidates newer than the
    snapshot (started after it) are listed as "outside", to resume by hand. Same shape as tmux_plan, plus
    "iterm": [{"bounds", "tabs": [tmux session]}] front window first, and "snapshot": its path."""
    d_cand = {}   # pane_id -> its newest candidate
    l_outside = []
    for r in l_cand:
        r["stale"] = False
        pane_id = r["pane_id"]
        if pane_id and (pane_id not in d_cand or r["ts"] > d_cand[pane_id]["ts"]):
            d_cand[pane_id] = r
        elif not pane_id and r["ts"] > snap["ts"]:
            l_outside.append(r)

    d_sessions = {}   # tmux session -> {window_index: window}
    set_used = set()
    for p in sorted(snap["panes"], key=lambda p: (p["window_index"], p["pane_index"])):
        # the window's first pane (in pane order) gives its name, layout and size
        w = d_sessions.setdefault(p["session"], {}).setdefault(p["window_index"], {
            "name": p["window_name"] or None, "layout": p["layout"] or None, "size": layout_cells(p["layout"])[0],
            "panes": []})
        r = d_cand.get(p["pane_id"])
        if r and p["command"] not in SHELLS:
            set_used.add(r["uuid"])
            w["panes"].append(dict(r, cwd=p["cwd"]))
        else:
            w["panes"].append({"cmd": None, "cwd": p["cwd"]})
    l_outside += [r for r in d_cand.values() if r["uuid"] not in set_used and r["ts"] > snap["ts"]]

    d_iterm = {}   # iTerm2 window number -> {"bounds", "tabs": [tmux session]}
    for row in sorted(snap["iterm"], key=lambda x: (x["window"], x["tab"])):
        w = d_iterm.setdefault(row["window"], {"bounds": row["bounds"], "tabs": []})
        name = snap["clients"].get(row["tty"])
        if name and name not in w["tabs"]:
            w["tabs"].append(name)
    return {"boot_ts": prev, "newest_ts": snap["ts"], "sessions": d_sessions, "stale": [], "outside": l_outside,
            "iterm": [w for _, w in sorted(d_iterm.items()) if w["tabs"]], "snapshot": snap["path"]}


def _is_claude(p):
    """A planned pane that gets `claude --resume` (else a plain shell: None, or {"cmd": None, "cwd"})."""
    return bool(p and p.get("cmd"))


def _pane_dir(p):
    """The folder a planned pane's shell starts in: its saved folder when it still exists, else ~."""
    wd = (p or {}).get("cwd")
    return wd if wd and os.path.isdir(wd) else HOME


def _applescript_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


BOUNDS_RE = re.compile(r"-?\d+(,-?\d+){3}")


def iterm_windows(plan, l_restored):
    """[(bounds or None, [tmux session, in tab order])], front window first: the snapshot's iTerm2 windows with
    only the restored tmux sessions; a restored one in no tab becomes a tab of the first window. No snapshot:
    one window, one tab per restored tmux session."""
    l_out = [(w["bounds"], [n for n in w["tabs"] if n in l_restored]) for w in plan.get("iterm") or []]
    l_out = [(b, l_tabs) for b, l_tabs in l_out if l_tabs]
    set_placed = {n for _, l_tabs in l_out for n in l_tabs}
    l_rest = [n for n in l_restored if n not in set_placed]
    if l_rest:
        if l_out:
            l_out[0][1].extend(l_rest)
        else:
            l_out = [(None, l_rest)]
    return l_out


def iterm_script(l_windows):
    """AppleScript: per (bounds, tmux sessions), one new iTerm2 window (at those bounds), one tab per tmux session,
    each attaching to it. Created back to front, so the first window ends in front."""
    l_osa = ['tell application "iTerm2"']
    for bounds, l_sessions in reversed(l_windows):
        l_osa.append("  set w to (create window with default profile)")
        if bounds and BOUNDS_RE.fullmatch(bounds):
            l_osa.append(f"  set bounds of w to {{{bounds}}}")
        for i, name in enumerate(l_sessions):
            if i:
                l_osa.append("  tell w to create tab with default profile")
            # Always quoted: in zsh an unquoted word starting with '=' is "the path of that command" (=name -> "zsh:
            # name not found"), and shlex.quote leaves '=name' bare (2026-11-07, the first real ares tmux).
            target = "=" + name
            cmd = "tmux attach -t '" + target.replace("'", "'\\''") + "'"
            l_osa.append(f"  tell current session of w to write text {_applescript_str(cmd)}")
    return "\n".join(l_osa + ["end tell"])


def claude_panes(d_windows):
    """The planned panes of one tmux session's windows that get `claude --resume`."""
    return [p for w in d_windows.values() for p in w["panes"] if _is_claude(p)]


def cmd_tmux(dry_run, include_stale, iterm, this_boot):
    """Print the plan; unless dry_run, carry it out. Returns the exit status."""
    plan = tmux_plan(include_stale, this_boot)
    if not this_boot:   # a tmux server killed without a reboot leaves this boot's sessions to restore too
        n_now = sum(len(claude_panes(d)) for d in tmux_plan(True, True)["sessions"].values())
        if n_now:
            print(f"ares tmux: {n_now} Claude session(s) of THIS boot ended without a clean exit (tmux server killed?):"
                  f" ares tmux --this-boot --dry-run")
    if plan["boot_ts"] is None:
        print(f"ares tmux: no previous boot in {TRACKER_SESSIONS_DIR}: nothing to restore."
              f" If the tmux server died without a reboot: ares tmux --this-boot --dry-run")
        return 0

    def tmux(*l_args):
        """Run one tmux command; its output, stripped. Raises on failure."""
        out = run_text(["tmux", *l_args])
        if out.returncode != 0:
            raise RuntimeError(f"tmux {shlex.join(l_args)}: {out.stderr.strip()}")
        return out.stdout.strip()

    n_claude = sum(len(claude_panes(ws)) for ws in plan["sessions"].values())
    which = "this boot (tmux died without a reboot)" if this_boot else "previous boot"
    head = f"ares tmux{' --this-boot' if this_boot else ''}{' --dry-run' if dry_run else ''}: {which} {_fmt_ts(plan['boot_ts'])}, "
    if plan.get("snapshot"):
        print(head + f"its snapshot of {_fmt_ts(plan['newest_ts'])} ({plan['snapshot']}); {n_claude} Claude session(s) in tmux then")
    else:
        # newest_ts 0: no Claude session ever ticked here (a new machine): say so, not "1970-01-01".
        guess = f"guessed from its last tick {_fmt_ts(plan['newest_ts'])}" if plan["newest_ts"] else "no data on this machine"
        print(head + f"no snapshot, {guess}; {n_claude} Claude session(s)"
              f" in tmux then{'' if include_stale else ' (stale ones need --all)'}")

    l_restored = []
    l_started = []   # (tmux session, pane id) of every pane that was sent a claude command
    l_failed = []
    errors = 0
    for name, d_windows in plan["sessions"].items():
        if subprocess.run(["tmux", "has-session", "-t", f"={name}"],
                          capture_output=True).returncode == 0:   # it already exists
            print(f"  skip     tmux session {name!r}: already exists, left as is. Its Claude session(s), by hand:")
            for r in claude_panes(d_windows):
                print(f"             {r['cmd']}")
            continue
        print(f"  restore  tmux session {name!r}: {len(d_windows)} window(s)")
        for widx, w in sorted(d_windows.items()):
            size = f"{w['size'][0]}x{w['size'][1]}" if w["size"] else "default size"
            print(f"    window {widx} {w['name']!r}, {size}, {len(w['panes'])} pane(s), layout {w['layout']}")
            for i, r in enumerate(w["panes"]):
                if _is_claude(r):
                    what = r["cmd"] + ("   (stale)" if r["stale"] else "")
                else:
                    what = "shell in " + _pane_dir(r)
                print(f"      pane {i}  {what}")
        if dry_run:
            l_restored.append(name)
            continue
        sid = None
        for widx, w in sorted(d_windows.items()):
            try:   # one window failing does not drop the session's other windows (tester, 2026-11-07)
                l_size = ["-x", str(w["size"][0]), "-y", str(w["size"][1])] if w["size"] else []
                l_name = ["-n", w["name"]] if w["name"] else []
                if sid is None:
                    sid = tmux("new-session", "-d", "-P", "-F", "#{session_id}", "-s", name, *l_name,
                               *l_size, "-c", _pane_dir(w["panes"][0]))
                    wid, got = tmux("display-message", "-p", "-t", f"{sid}:", "#{window_id} #{window_index}").split()
                    if int(got) != widx:   # the first window lands on base-index: move it to its saved index
                        tmux("move-window", "-s", wid, "-t", f"{sid}:{widx}")
                else:
                    wid = tmux("new-window", "-d", "-P", "-F", "#{window_id}", "-t", f"{sid}:{widx}", *l_name,
                               "-c", _pane_dir(w["panes"][0]))
                if l_size:   # the saved size first, or the splits below may not fit
                    tmux("resize-window", "-t", wid, *l_size)
                for _ in w["panes"][1:]:
                    tmux("split-window", "-d", "-t", wid, "-c", HOME)
                    tmux("select-layout", "-t", wid, "tiled")   # rebalance: else the 6th split finds "no space"
                if w["layout"]:
                    tmux("select-layout", "-t", wid, w["layout"])
                if l_size:   # resize-window fixed the size: let it follow the terminal again once attached
                    tmux("set-option", "-w", "-u", "-t", wid, "window-size")
                l_pane_ids = tmux("list-panes", "-t", wid, "-F", "#{pane_id}").split()
                for i, (pane_id, r) in enumerate(zip(l_pane_ids, w["panes"])):
                    if _is_claude(r):
                        tmux("send-keys", "-t", pane_id, r["cmd"], "Enter")
                        l_started.append((name, pane_id))
                    elif i and _pane_dir(r) != HOME:   # splits start in ~: a fresh shell in the pane's own folder
                        tmux("respawn-pane", "-k", "-t", pane_id, "-c", _pane_dir(r))
            except (RuntimeError, OSError) as e:
                errors += 1
                eprint(f"  ERROR    tmux session {name!r}, window {widx}: {e}")
                if sid is None:   # the session itself could not be created: nothing more to do for it
                    break
        if sid is not None:
            l_restored.append(name)

    if not dry_run and l_started:   # a pane back at its shell prompt: claude was not found, or died at once
        time.sleep(CLAUDE_START_WAIT_S)
        for name, pane_id in l_started:
            try:
                cmd = tmux("display-message", "-p", "-t", pane_id, "#{pane_current_command}").lstrip("-")
            except RuntimeError:
                continue
            if cmd in SHELLS:
                errors += 1
                eprint(f"  ERROR    tmux session {name!r}, pane {pane_id}: no Claude session running (claude not found"
                       f" on the PATH of that pane, or it exited at once); the pane shows why")
                l_failed.append(name)

    for r in plan["stale"]:
        where = r["seen"].get("pane") or r["start"].get("pane") or "?"
        seen = f"last seen {_fmt_ts(r['ts'])}" if r["seen"].get("ts") else "no last_seen.json of that boot"
        print(f"  stale    {r['uuid']} in {where}: {seen} (not restored; --all restores it)")
    for r in plan["outside"]:
        print(f"  no tmux  {r['uuid']}: by hand: {r['cmd']}")

    if not l_restored:
        print("  iTerm2   nothing to open")
    elif not iterm:
        print(f"  iTerm2   skipped (--no-iterm); attach with: tmux attach -t ={l_restored[0]}")
    else:
        l_windows = iterm_windows(plan, l_restored)
        script = iterm_script(l_windows)
        if dry_run:
            # the windows' tabs, then the script, each of its lines indented by 4
            print(f"  iTerm2   {len(l_windows)} window(s): " + " | ".join(", ".join(t) for _, t in l_windows))
            print(textwrap.indent(script, "    "))
        elif sys.platform != "darwin":
            print("  iTerm2   skipped (not macOS)")
        else:
            out = run_text(["osascript", "-e", script])
            if out.returncode == 0:
                print(f"  iTerm2   {len(l_windows)} window(s), {len(l_restored)} tab(s) opened")
            else:
                errors += 1
                eprint(f"  ERROR    iTerm2: {out.stderr.strip()}")
    if not dry_run and l_started:
        n_ok = len(l_started) - len(l_failed)
        print(f"  summary  {n_ok} of {len(l_started)} Claude pane(s) running" + (f", {len(l_failed)} without claude" if l_failed else ""))
    return 1 if errors else 0


