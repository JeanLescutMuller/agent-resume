{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/opt/agent-resume/session_start.py\"",
            "async": false,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/opt/agent-resume/session_end.sh\"",
            "async": false,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
